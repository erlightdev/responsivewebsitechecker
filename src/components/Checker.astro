<!-- Annotation editor (shared) -->
<CaptureEditor />

<script>
  import { screenshot, record, isSupported, isSharing, stopSharing } from '../lib/capture-media';
  import { mountEditor } from '../lib/capture-editor';
  import type { Capture } from '../lib/captures-db';

  // ---------- state ----------
  type Device = { id: string; name: string; w: number; h: number; type: string; rotated: boolean };
  type Layout = 'row' | 'grid';

  let currentUrl = '';
  let zoom: number | 'fit' = 'fit';
  let layout: Layout = 'row';
  let framesOn = true;
  let customCount = 0;
  const active = new Map<string, Device>();
  const customScreens = new Map<string, Device>(); // user-defined screen definitions
  type PageMeta = { url: string; title: string; pageName: string; updatedAt: number };
  let latestPageMeta: PageMeta | null = null;

  // ---------- elements ----------
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $('url-form') as unknown as HTMLFormElement;
  const input = $<HTMLInputElement>('url-input');
  const clearBtn = $('clear-btn');
  const frames = $('frames');
  const emptyState = $('empty-state');
  const zoomLabel = $('zoom-label');
  const deviceCount = $('device-count');
  const sidebar = $('sidebar');
  const backdrop = $('sidebar-backdrop');

  // ---------- persistence ----------
  type VPState = { url?: string; layout: Layout; zoom: number | 'fit'; framesOn?: boolean; devices: Device[]; customScreens?: Device[] };

  // A snapshot of everything that makes up the current arrangement.
  function snapshot(): VPState {
    return {
      url: currentUrl,
      layout,
      zoom,
      framesOn,
      devices: [...active.values()],
      customScreens: [...customScreens.values()],
    };
  }

  const store = {
    save() {
      try {
        localStorage.setItem('vp-state', JSON.stringify(snapshot()));
      } catch { /* private mode etc. */ }
    },
    load() {
      try {
        const raw = localStorage.getItem('vp-state');
        if (!raw) return null;
        return JSON.parse(raw) as VPState;
      } catch {
        return null;
      }
    },
  };

  // ---------- init devices ----------
  const trackCustomCount = (id: string) => {
    if (id.startsWith('custom-')) customCount = Math.max(customCount, Number(id.split('-')[1]) || 0);
  };
  const saved = store.load();
  if (saved) {
    if (saved.url) currentUrl = saved.url;
    layout = saved.layout === 'grid' ? 'grid' : 'row';
    zoom = saved.zoom === 'fit' || typeof saved.zoom === 'number' ? saved.zoom : 'fit';
    framesOn = saved.framesOn !== false;
    saved.customScreens?.forEach((d) => { customScreens.set(d.id, d); trackCustomCount(d.id); });
  }
  if (saved?.devices?.length) {
    saved.devices.forEach((d) => {
      active.set(d.id, d);
      trackCustomCount(d.id);
      // migrate older saves where custom devices weren't tracked separately
      if (d.id.startsWith('custom-') && !customScreens.has(d.id)) customScreens.set(d.id, { ...d, rotated: false });
    });
  } else if (!saved) {
    document.querySelectorAll<HTMLButtonElement>('.device-row[data-on="true"]').forEach((row) => {
      active.set(row.dataset.id!, {
        id: row.dataset.id!,
        name: row.dataset.name!,
        w: Number(row.dataset.w),
        h: Number(row.dataset.h),
        type: row.dataset.type!,
        rotated: false,
      });
    });
  }
  // sync built-in sidebar checkmarks with state (custom rows are built later)
  document.querySelectorAll<HTMLButtonElement>('.device-row').forEach((row) => {
    row.dataset.on = String(active.has(row.dataset.id!));
  });

  // ---------- helpers ----------
  function normalizeUrl(raw: string): string | null {
    let v = raw.trim();
    if (!v) return null;
    if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
    try {
      const u = new URL(v);
      if (!u.hostname.includes('.') && u.hostname !== 'localhost') return null;
      return u.href;
    } catch {
      return null;
    }
  }

  function fitScale(w: number): number {
    if (w <= 500) return 0.72; // phones
    if (w <= 1100) return 0.48; // tablets
    return 0.36; // laptops / desktops
  }
  const scaleFor = (w: number) => (zoom === 'fit' ? fitScale(w) : zoom);

  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  function titleCase(s: string): string {
    return s
      .replace(/[-_]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/\b\w/g, (c) => c.toUpperCase());
  }

  function websiteName(u: string): string {
    try {
      const host = new URL(u).hostname.replace(/^www\./i, '');
      const parts = host.split('.');
      const name = parts.length > 2 ? parts[parts.length - 2] : parts[0];
      return titleCase(name || host);
    } catch {
      return 'Website';
    }
  }

  function pageNameFromUrl(u: string): string {
    try {
      const url = new URL(u);
      const last = url.pathname.split('/').filter(Boolean).pop();
      return last ? titleCase(decodeURIComponent(last)) : 'Home';
    } catch {
      return 'Page';
    }
  }

  function cleanPageTitle(raw: string, siteName: string): string {
    const title = raw.replace(/\s+/g, ' ').trim();
    if (!title) return '';
    const parts = title.split(/\s[-|•:]\s/).map((part) => part.trim()).filter(Boolean);
    const withoutSite = parts.find((part) => part.toLowerCase() !== siteName.toLowerCase());
    return withoutSite || title;
  }

  function formatCaptureTitle(): string {
    const url = latestPageMeta?.url || currentUrl;
    const site = websiteName(url);
    const page = latestPageMeta?.pageName || pageNameFromUrl(url);
    return page && page.toLowerCase() !== site.toLowerCase() ? `${site} - ${page}` : site;
  }

  function visitedUrlFromFrame(iframe: HTMLIFrameElement): string {
    try {
      const loc = iframe.contentWindow?.location;
      if (!loc) return currentUrl;
      const params = new URLSearchParams(loc.search);
      const origin = params.get('__vphost');
      if (!origin) return currentUrl;
      params.delete('__vphost');
      params.delete('__cb');
      const qs = params.toString();
      return `${origin}${loc.pathname}${qs ? `?${qs}` : ''}${loc.hash}`;
    } catch {
      return currentUrl;
    }
  }

  function updatePageMetaFromFrame(iframe: HTMLIFrameElement) {
    const url = visitedUrlFromFrame(iframe);
    const site = websiteName(url);
    let pageName = pageNameFromUrl(url);
    try {
      const title = cleanPageTitle(iframe.contentDocument?.title || '', site);
      if (title) pageName = title;
    } catch { /* cross-origin or blocked frame */ }
    latestPageMeta = { url, title: `${site} - ${pageName}`, pageName, updatedAt: Date.now() };
  }

  function attachFrameTracking(iframe: HTMLIFrameElement) {
    updatePageMetaFromFrame(iframe);
  }

  // Build a same-origin proxy URL whose path mirrors the target's, so SPA
  // routers (which branch on location.pathname) see the real route. The target
  // origin rides along in a __vphost marker the proxy middleware reads.
  // `bust` forces a fresh upstream fetch (bypasses the proxy's TTL cache) by
  // making the request URL unique — used by "Clear cache".
  function toProxy(raw: string, bust?: number): string {
    try {
      const u = new URL(raw);
      const params = new URLSearchParams(u.search);
      params.set('__vphost', u.origin);
      if (bust) params.set('__cb', String(bust));
      return `${u.pathname}?${params.toString()}${u.hash}`;
    } catch {
      return raw;
    }
  }

  // ---------- pane rendering ----------
  function pane(d: Device): HTMLElement {
    const w = d.rotated ? d.h : d.w;
    const h = d.rotated ? d.w : d.h;
    const s = scaleFor(w);
    const sw = Math.round(w * s);
    const sh = Math.round(h * s);
    const name = escapeHtml(d.name);

    const el = document.createElement('div');
    el.className = 'flex shrink-0 flex-col';
    el.dataset.frameId = d.id;

    // screen = overlays + iframe; skin differs per device type
    const screen = `
      <div class="relative overflow-hidden bg-card" data-role="screen" style="width:${sw}px;height:${sh}px">
        <div data-role="loader" class="absolute inset-0 z-10 grid place-items-center bg-card">
          <div class="size-6 animate-spin rounded-full border-2 border-muted border-t-primary"></div>
        </div>
        <iframe
          title="${name} preview"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
          loading="lazy"
          style="width:${w}px;height:${h}px;transform:scale(${s});transform-origin:top left;border:0"
        ></iframe>
      </div>
    `;

    let skin: string;
    if (!framesOn) {
      // bare screen — no device chrome
      skin = `<div class="overflow-hidden rounded-md border border-border/70 shadow-lg">${screen}</div>`;
    } else if (d.type === 'phone') {
      skin = `
        <div class="rounded-[2rem] border border-border/70 bg-neutral-950 p-2 ${d.rotated ? 'pl-5' : 'pt-5'} shadow-2xl dark:bg-black">
          ${d.rotated
            ? '<div class="absolute left-2 top-1/2 h-12 w-1 -translate-y-1/2 rounded-full bg-neutral-800"></div>'
            : '<div class="absolute left-1/2 top-2 h-1 w-12 -translate-x-1/2 rounded-full bg-neutral-800"></div>'}
          <div class="overflow-hidden rounded-[1.4rem]">${screen}</div>
        </div>
      `;
    } else if (d.type === 'tablet') {
      skin = `
        <div class="rounded-[1.4rem] border border-border/70 bg-neutral-950 p-2.5 shadow-2xl dark:bg-black">
          <div class="overflow-hidden rounded-[0.9rem]">${screen}</div>
        </div>
      `;
    } else {
      // browser chrome for laptop / desktop / custom
      skin = `
        <div class="overflow-hidden rounded-lg border border-border/70 bg-card shadow-2xl">
          <div class="flex items-center gap-2 border-b border-border/60 bg-muted/40 px-3 py-1.5">
            <span class="flex gap-1.5">
              <span class="size-2.5 rounded-full bg-destructive/60"></span>
              <span class="size-2.5 rounded-full bg-chart-3/60"></span>
              <span class="size-2.5 rounded-full bg-primary/60"></span>
            </span>
            <span data-role="chrome-url" class="min-w-0 flex-1 truncate rounded bg-background/70 px-2 py-0.5 text-[10px] text-muted-foreground"></span>
          </div>
          ${screen}
        </div>
      `;
    }

    el.innerHTML = `
      <div class="mb-2 flex items-center justify-between gap-2 px-0.5" style="width:${sw + (!framesOn || d.type === 'desktop' ? 2 : 20)}px">
        <div class="flex min-w-0 items-center gap-1.5">
          <button type="button" data-action="drag" class="tip drag-handle grid size-7 shrink-0 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Drag to reorder ${name}" data-tip="Drag to reorder" data-tip-align="start">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="9" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg>
          </button>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">${name}</p>
            <p class="text-xs tabular-nums text-muted-foreground">${w} × ${h} · ${Math.round(s * 100)}%</p>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-0.5">
          <button type="button" data-action="rotate" class="tip grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Rotate ${name}" data-tip="Rotate">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/></svg>
          </button>
          <button type="button" data-action="reload" class="tip grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Reload ${name}" data-tip="Reload">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
          </button>
          <a data-action="open" href="${escapeHtml(currentUrl)}" target="_blank" rel="noopener noreferrer" class="tip grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Open ${name} in new tab" data-tip="Open in new tab">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
          <button type="button" data-action="close" class="tip grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-destructive" aria-label="Remove ${name}" data-tip="Remove" data-tip-align="end">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div class="relative">${skin}</div>
    `;

    const iframe = el.querySelector('iframe')!;
    const loader = el.querySelector<HTMLElement>('[data-role="loader"]')!;
    const chromeUrl = el.querySelector<HTMLElement>('[data-role="chrome-url"]');
    if (chromeUrl) chromeUrl.textContent = currentUrl.replace(/^https?:\/\//, '');

    iframe.addEventListener('load', () => {
      loader.style.display = 'none';
      attachFrameTracking(iframe);
    });
    const startLoad = (bust?: number) => {
      loader.style.display = 'grid';
      iframe.src = toProxy(currentUrl, bust);
    };
    startLoad();
    // expose an in-place reload so navbar "Clear cache" can refresh this pane
    // without rebuilding it (keeps device/zoom/rotation state intact)
    (el as unknown as { __reload: (bust?: number) => void }).__reload = startLoad;

    el.querySelector('[data-action="reload"]')!.addEventListener('click', () => startLoad());
    el.querySelector('[data-action="rotate"]')!.addEventListener('click', () => {
      d.rotated = !d.rotated;
      el.replaceWith(pane(d));
      store.save();
    });
    el.querySelector('[data-action="close"]')!.addEventListener('click', () => {
      removeDevice(d.id);
    });

    // ----- drag to reorder (only when grabbing the handle) -----
    const handle = el.querySelector<HTMLElement>('[data-action="drag"]')!;
    handle.addEventListener('mousedown', () => {
      el.setAttribute('draggable', 'true');
      const off = () => { el.removeAttribute('draggable'); window.removeEventListener('mouseup', off); };
      window.addEventListener('mouseup', off);
    });
    el.addEventListener('dragstart', (e) => {
      el.classList.add('dragging');
      frames.classList.add('dragging-active');
      e.dataTransfer!.effectAllowed = 'move';
      e.dataTransfer!.setData('text/plain', d.id);
    });
    el.addEventListener('dragend', () => {
      el.classList.remove('dragging');
      frames.classList.remove('dragging-active');
      el.removeAttribute('draggable');
      persistOrder();
    });

    return el;
  }

  // Recompute `active` order from the DOM and persist.
  function persistOrder() {
    const ordered = [...frames.querySelectorAll<HTMLElement>('[data-frame-id]')]
      .map((el) => el.dataset.frameId!)
      .filter((id) => active.has(id))
      .map((id) => [id, active.get(id)!] as const);
    active.clear();
    ordered.forEach(([id, dev]) => active.set(id, dev));
    store.save();
  }

  // Find where to drop relative to the nearest pane (works for row + grid).
  function dragTarget(x: number, y: number) {
    const els = [...frames.querySelectorAll<HTMLElement>('[data-frame-id]:not(.dragging)')];
    let best: { dist: number; el: HTMLElement; after: boolean } | null = null;
    for (const child of els) {
      const b = child.getBoundingClientRect();
      const cx = b.left + b.width / 2;
      const cy = b.top + b.height / 2;
      const dist = Math.hypot(x - cx, y - cy);
      if (!best || dist < best.dist) {
        const after = layout === 'grid'
          ? (y > b.bottom ? true : y < b.top ? false : x > cx)
          : x > cx;
        best = { dist, el: child, after };
      }
    }
    return best;
  }

  // ---------- canvas ----------
  function applyLayout() {
    frames.className =
      layout === 'row'
        ? 'flex w-max min-w-full items-start gap-10 px-8 py-7'
        : 'flex flex-wrap items-start justify-center gap-10 px-8 py-7';
    document.querySelectorAll<HTMLButtonElement>('.layout-btn').forEach((b) => {
      b.dataset.on = String(b.dataset.layout === layout);
    });
  }

  function renderAll() {
    if (!currentUrl) return;
    frames.innerHTML = '';
    active.forEach((d) => frames.appendChild(pane(d)));
    emptyState.style.display = 'none';
    applyLayout();
    updateCount();
  }

  function updateCount() {
    deviceCount.textContent = String(active.size);
  }

  function addDevice(d: Device) {
    active.set(d.id, d);
    const row = document.querySelector<HTMLElement>(`.device-row[data-id="${d.id}"]`);
    if (row) row.dataset.on = 'true';
    if (currentUrl) frames.appendChild(pane(d));
    updateCount();
    store.save();
  }

  function removeDevice(id: string) {
    active.delete(id);
    const row = document.querySelector<HTMLElement>(`.device-row[data-id="${id}"]`);
    if (row) row.dataset.on = 'false';
    frames.querySelector(`[data-frame-id="${id}"]`)?.remove();
    updateCount();
    store.save();
  }

  // ---------- events ----------
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = normalizeUrl(input.value);
    if (!url) {
      input.focus();
      input.classList.add('text-destructive');
      setTimeout(() => input.classList.remove('text-destructive'), 1200);
      return;
    }
    currentUrl = url;
    latestPageMeta = null;
    input.value = url;
    clearBtn.style.display = 'block';
    closeSidebar();
    renderAll();
    store.save();
  });

  input.addEventListener('input', () => {
    clearBtn.style.display = input.value ? 'block' : 'none';
  });
  clearBtn.addEventListener('click', () => {
    input.value = '';
    clearBtn.style.display = 'none';
    input.focus();
  });

  document.querySelectorAll<HTMLButtonElement>('.sample-url').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.url!;
      form.requestSubmit();
    })
  );

  // toggle a device on/off from its sidebar row (built-in or custom)
  function toggleRow(row: HTMLElement) {
    const id = row.dataset.id!;
    if (active.has(id)) {
      removeDevice(id);
    } else {
      addDevice({
        id,
        name: row.dataset.name!,
        w: Number(row.dataset.w),
        h: Number(row.dataset.h),
        type: row.dataset.type!,
        rotated: false,
      });
    }
  }

  // sidebar device rows (built-in)
  document.querySelectorAll<HTMLButtonElement>('.device-row').forEach((row) =>
    row.addEventListener('click', () => toggleRow(row))
  );

  // ---------- custom screens ----------
  const customList = $('custom-list');
  const customGroup = $('custom-group');

  const typeForWidth = (w: number) => (w <= 500 ? 'phone' : w <= 1100 ? 'tablet' : 'desktop');

  function syncCustomGroup() {
    customGroup.style.display = customScreens.size ? 'block' : 'none';
  }

  // Build + insert a sidebar row for a custom screen definition.
  function insertCustomRow(d: Device) {
    const name = escapeHtml(d.name);
    const li = document.createElement('li');
    li.dataset.customId = d.id;
    li.innerHTML = `
      <div class="device-row group flex w-full items-center gap-2 rounded-md px-2 py-2 text-left text-sm transition-colors hover:bg-muted"
        role="button" tabindex="0"
        data-id="${d.id}" data-name="${name}" data-w="${d.w}" data-h="${d.h}" data-type="${d.type}" data-on="${String(active.has(d.id))}">
        <span class="grid size-4 shrink-0 place-items-center rounded border border-border transition-colors group-data-[on=true]:border-primary group-data-[on=true]:bg-primary">
          <svg class="size-3 text-primary-foreground opacity-0 transition-opacity group-data-[on=true]:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="min-w-0 flex-1 truncate">${name}</span>
        <span class="shrink-0 text-xs tabular-nums text-muted-foreground">${d.w}×${d.h}</span>
        <button type="button" class="custom-del grid size-5 shrink-0 place-items-center rounded text-muted-foreground opacity-0 transition-opacity hover:text-destructive focus-visible:opacity-100 group-hover:opacity-100" aria-label="Delete ${name}" title="Delete screen">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
        </button>
      </div>`;
    const row = li.querySelector<HTMLElement>('.device-row')!;
    const del = li.querySelector<HTMLButtonElement>('.custom-del')!;
    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.custom-del')) return;
      toggleRow(row);
    });
    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRow(row); }
    });
    del.addEventListener('click', (e) => { e.stopPropagation(); promptDeleteScreen(d.id); });
    customList.appendChild(li);
    syncCustomGroup();
  }

  function deleteCustomScreen(id: string) {
    if (active.has(id)) removeDevice(id);
    customScreens.delete(id);
    customList.querySelector(`li[data-custom-id="${id}"]`)?.remove();
    syncCustomGroup();
    store.save();
  }

  function addCustomScreen(name: string, w: number, h: number) {
    customCount += 1;
    const d: Device = {
      id: `custom-${customCount}`,
      name: name.trim() || `Custom ${w}×${h}`,
      w, h,
      type: typeForWidth(w),
      rotated: false,
    };
    customScreens.set(d.id, d);
    insertCustomRow(d);
    addDevice(d); // activate + render + persist
  }

  // ---------- Add Screen modal ----------
  const modal = $('screen-modal');
  const nameEl = $<HTMLInputElement>('screen-name');
  const wEl = $<HTMLInputElement>('screen-w');
  const hEl = $<HTMLInputElement>('screen-h');
  const errEl = $('screen-error');

  function openModal() {
    nameEl.value = '';
    wEl.value = '';
    hEl.value = '';
    errEl.style.display = 'none';
    modal.style.display = 'flex';
    setTimeout(() => nameEl.focus(), 0);
  }
  function closeModal() {
    modal.style.display = 'none';
  }

  $('add-screen').addEventListener('click', openModal);
  $('screen-cancel').addEventListener('click', closeModal);
  $('screen-modal-close').addEventListener('click', closeModal);
  $('screen-modal-overlay').addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
  });

  ($('screen-form') as unknown as HTMLFormElement).addEventListener('submit', (e) => {
    e.preventDefault();
    const w = Number(wEl.value);
    const h = Number(hEl.value);
    if (!w || !h || w < 200 || w > 3840 || h < 200 || h > 3840) {
      errEl.style.display = 'block';
      return;
    }
    addCustomScreen(nameEl.value, w, h);
    closeModal();
  });

  // ---------- Delete confirmation modal ----------
  const deleteModal = $('delete-modal');
  const deleteNameEl = $('delete-modal-name');
  let pendingDeleteId: string | null = null;

  function promptDeleteScreen(id: string) {
    pendingDeleteId = id;
    deleteNameEl.textContent = customScreens.get(id)?.name ?? 'This screen';
    deleteModal.style.display = 'flex';
    setTimeout(() => $('delete-cancel').focus(), 0);
  }
  function closeDeleteModal() {
    deleteModal.style.display = 'none';
    pendingDeleteId = null;
  }

  $('delete-cancel').addEventListener('click', closeDeleteModal);
  $('delete-modal-overlay').addEventListener('click', closeDeleteModal);
  $('delete-confirm').addEventListener('click', () => {
    if (pendingDeleteId) deleteCustomScreen(pendingDeleteId);
    closeDeleteModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && deleteModal.style.display === 'flex') closeDeleteModal();
  });

  // layout
  document.querySelectorAll<HTMLButtonElement>('.layout-btn').forEach((b) =>
    b.addEventListener('click', () => {
      layout = (b.dataset.layout as Layout) ?? 'row';
      applyLayout();
      store.save();
    })
  );

  // zoom
  const ZOOMS = [0.25, 0.36, 0.5, 0.65, 0.8, 1];
  function setZoom(z: number | 'fit') {
    zoom = z;
    zoomLabel.textContent = z === 'fit' ? 'Fit' : `${Math.round(z * 100)}%`;
    store.save();
    renderAll();
  }
  zoomLabel.addEventListener('click', () => setZoom('fit'));
  document.querySelectorAll<HTMLButtonElement>('[data-zoom-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const dir = Number(b.dataset.zoomStep);
      const cur = zoom === 'fit' ? 0.5 : zoom;
      const idx = ZOOMS.findIndex((z) => z >= cur - 0.001);
      const next = ZOOMS[Math.min(ZOOMS.length - 1, Math.max(0, (idx === -1 ? 2 : idx) + dir))];
      setZoom(next);
    })
  );

  // device frame toggle
  const frameToggle = $('frame-toggle');
  function syncFrameToggle() {
    frameToggle.dataset.on = String(framesOn);
    frameToggle.setAttribute('aria-pressed', String(framesOn));
  }
  frameToggle.addEventListener('click', () => {
    framesOn = !framesOn;
    syncFrameToggle();
    store.save();
    renderAll();
  });

  // rotate / reload all
  $('rotate-all').addEventListener('click', () => {
    active.forEach((d) => (d.rotated = !d.rotated));
    store.save();
    renderAll();
  });
  $('reload-all').addEventListener('click', renderAll);

  // clear cache + soft reload — refresh every pane in place with a fresh
  // upstream fetch, keeping device/zoom/rotation state untouched. One shared
  // token means the proxy de-dupes to a single upstream hit per URL.
  $('clear-cache').addEventListener('click', () => {
    if (!currentUrl) return;
    const token = Date.now();
    frames.querySelectorAll<HTMLElement>('[data-frame-id]').forEach((el) =>
      (el as unknown as { __reload?: (bust?: number) => void }).__reload?.(token)
    );
  });

  // live reorder while dragging a pane over the canvas
  frames.addEventListener('dragover', (e) => {
    const dragging = frames.querySelector<HTMLElement>('.dragging');
    if (!dragging) return;
    e.preventDefault();
    e.dataTransfer!.dropEffect = 'move';
    const t = dragTarget(e.clientX, e.clientY);
    if (!t) { frames.appendChild(dragging); return; }
    if (t.after) frames.insertBefore(dragging, t.el.nextSibling);
    else frames.insertBefore(dragging, t.el);
  });
  frames.addEventListener('drop', (e) => e.preventDefault());

  // sidebar — drawer on mobile, collapse on desktop
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

  function closeSidebar() {
    sidebar.dataset.open = 'false';
    backdrop.style.display = 'none';
  }
  $('sidebar-toggle').addEventListener('click', () => {
    if (isDesktop()) {
      const collapsed = sidebar.dataset.collapsed !== 'true';
      sidebar.dataset.collapsed = String(collapsed);
      try { localStorage.setItem('vp-sidebar', collapsed ? 'collapsed' : 'open'); } catch { /* private mode */ }
    } else {
      const open = sidebar.dataset.open !== 'true';
      sidebar.dataset.open = String(open);
      backdrop.style.display = open ? 'block' : 'none';
    }
  });
  backdrop.addEventListener('click', closeSidebar);

  // restore desktop collapse preference
  try {
    if (localStorage.getItem('vp-sidebar') === 'collapsed') sidebar.dataset.collapsed = 'true';
  } catch { /* private mode */ }

  // init UI state
  applyLayout();
  syncFrameToggle();
  customScreens.forEach((d) => insertCustomRow(d)); // rebuild saved custom screens
  zoomLabel.textContent = zoom === 'fit' ? 'Fit' : `${Math.round((zoom as number) * 100)}%`;
  updateCount();

  // restore a previously checked URL + its previews
  if (currentUrl) {
    input.value = currentUrl;
    clearBtn.style.display = 'block';
    renderAll();
  }

  // ---------- navbar dropdowns (account + theme) ----------
  const accountMenu = $('account-menu');
  const menus = [
    { btn: $('account-btn'), menu: accountMenu },
    { btn: $('theme-btn'), menu: $('theme-menu') },
    { btn: $('workspace-btn'), menu: $('workspace-menu') },
    { btn: $('capture-btn'), menu: $('capture-menu') },
  ];
  const isOpen = (m: HTMLElement) => m.style.display === 'block';
  function setMenu(menu: HTMLElement, btn: HTMLElement, open: boolean) {
    menu.style.display = open ? 'block' : 'none';
    btn.setAttribute('aria-expanded', String(open));
  }
  function closeAllMenus() {
    menus.forEach((m) => setMenu(m.menu, m.btn, false));
  }
  const closeAccountMenu = () => setMenu(accountMenu, menus[0].btn, false);

  menus.forEach(({ btn, menu }) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !isOpen(menu);
      closeAllMenus();
      setMenu(menu, btn, open);
    });
  });
  document.addEventListener('click', (e) => {
    menus.forEach(({ btn, menu }) => {
      if (isOpen(menu) && !menu.contains(e.target as Node) && !btn.contains(e.target as Node)) setMenu(menu, btn, false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const open = menus.find((m) => isOpen(m.menu));
      if (open) { setMenu(open.menu, open.btn, false); open.btn.focus(); }
    }
  });

  // ---------- theme (light | dark | system) ----------
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const themeMode = () => (localStorage.getItem('vp-theme') as 'light' | 'dark' | 'system' | null) ?? 'system';

  function applyTheme() {
    const mode = themeMode();
    const dark = mode === 'dark' || (mode === 'system' && prefersDark.matches);
    document.documentElement.classList.toggle('dark', dark);
    document.querySelectorAll<HTMLElement>('.theme-mode').forEach((b) =>
      b.setAttribute('aria-checked', String(b.dataset.themeMode === mode))
    );
  }
  document.querySelectorAll<HTMLButtonElement>('.theme-mode').forEach((b) =>
    b.addEventListener('click', () => {
      localStorage.setItem('vp-theme', b.dataset.themeMode!);
      applyTheme();
    })
  );
  // react to OS theme changes while in "system" mode
  prefersDark.addEventListener('change', () => { if (themeMode() === 'system') applyTheme(); });
  applyTheme();

  // ---------- color theme (accent palette) ----------
  const colorTheme = () => localStorage.getItem('vp-color') || 'emerald';
  function applyColor() {
    const c = colorTheme();
    document.documentElement.dataset.theme = c;
    document.querySelectorAll<HTMLElement>('.color-swatch').forEach((b) =>
      b.setAttribute('aria-checked', String(b.dataset.color === c))
    );
  }
  document.querySelectorAll<HTMLButtonElement>('.color-swatch').forEach((b) =>
    b.addEventListener('click', () => {
      localStorage.setItem('vp-color', b.dataset.color!);
      applyColor();
    })
  );
  applyColor();

  // ---------- workspaces ----------
  type Workspace = { id: string; name: string; state: VPState };
  const WS_KEY = 'vp-workspaces';
  const ACTIVE_WS_KEY = 'vp-active-ws';
  const wsList = $('ws-list');
  const wsEmpty = $('ws-empty');

  const loadWorkspaces = (): Workspace[] => {
    try { return JSON.parse(localStorage.getItem(WS_KEY) || '[]'); } catch { return []; }
  };
  const saveWorkspaces = (list: Workspace[]) => {
    try { localStorage.setItem(WS_KEY, JSON.stringify(list)); } catch { /* private mode */ }
  };
  const activeWsId = () => localStorage.getItem(ACTIVE_WS_KEY) || '';

  // Apply a saved arrangement at runtime (no page reload).
  function applyState(s: VPState) {
    currentUrl = s.url || '';
    input.value = currentUrl;
    clearBtn.style.display = currentUrl ? 'block' : 'none';
    layout = s.layout === 'grid' ? 'grid' : 'row';
    zoom = s.zoom === 'fit' || typeof s.zoom === 'number' ? s.zoom : 'fit';
    framesOn = s.framesOn !== false;

    active.clear();
    (s.devices || []).forEach((d) => active.set(d.id, d));

    // rebuild custom screens + their sidebar rows
    customScreens.clear();
    customList.innerHTML = '';
    (s.customScreens || []).forEach((d) => { customScreens.set(d.id, d); trackCustomCount(d.id); insertCustomRow(d); });
    syncCustomGroup();

    document.querySelectorAll<HTMLButtonElement>('.device-row').forEach((row) => {
      row.dataset.on = String(active.has(row.dataset.id!));
    });

    applyLayout();
    syncFrameToggle();
    zoomLabel.textContent = zoom === 'fit' ? 'Fit' : `${Math.round((zoom as number) * 100)}%`;
    updateCount();
    if (currentUrl) {
      renderAll();
    } else {
      frames.innerHTML = '';
      emptyState.style.display = 'flex';
    }
    store.save();
  }

  function renderWorkspaces() {
    const list = loadWorkspaces();
    const activeId = activeWsId();
    wsList.innerHTML = '';
    wsEmpty.style.display = list.length ? 'none' : 'block';
    list.forEach((ws) => {
      const li = document.createElement('li');
      const isActive = ws.id === activeId;
      li.innerHTML = `
        <div class="group flex items-center gap-1 rounded-sm px-1 hover:bg-accent">
          <button type="button" class="ws-load flex min-w-0 flex-1 items-center gap-2 py-1.5 pl-1 text-left text-sm outline-none" data-id="${ws.id}">
            <svg class="size-3.5 shrink-0 ${isActive ? 'text-primary' : 'text-muted-foreground'}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5-9 4.5-9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/></svg>
            <span class="min-w-0 flex-1 truncate ${isActive ? 'font-medium' : ''}">${escapeHtml(ws.name)}</span>
            ${isActive ? '<span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide text-primary">Active</span>' : ''}
          </button>
          <button type="button" class="ws-del grid size-6 shrink-0 place-items-center rounded text-muted-foreground opacity-0 transition-opacity hover:text-destructive focus-visible:opacity-100 group-hover:opacity-100" data-id="${ws.id}" aria-label="Delete ${escapeHtml(ws.name)}" title="Delete workspace">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
          </button>
        </div>`;
      li.querySelector<HTMLButtonElement>('.ws-load')!.addEventListener('click', () => {
        const found = loadWorkspaces().find((w) => w.id === ws.id);
        if (!found) return;
        applyState(found.state);
        localStorage.setItem(ACTIVE_WS_KEY, ws.id);
        renderWorkspaces();
        closeAllMenus();
      });
      li.querySelector<HTMLButtonElement>('.ws-del')!.addEventListener('click', (e) => {
        e.stopPropagation();
        saveWorkspaces(loadWorkspaces().filter((w) => w.id !== ws.id));
        if (activeWsId() === ws.id) localStorage.removeItem(ACTIVE_WS_KEY);
        renderWorkspaces();
      });
      wsList.appendChild(li);
    });
  }

  // Save modal
  const wsModal = $('workspace-modal');
  const wsNameEl = $<HTMLInputElement>('workspace-name');
  const wsErr = $('workspace-error');
  function openWsModal() {
    wsNameEl.value = '';
    wsErr.style.display = 'none';
    wsModal.style.display = 'flex';
    setTimeout(() => wsNameEl.focus(), 0);
  }
  const closeWsModal = () => { wsModal.style.display = 'none'; };

  $('ws-save').addEventListener('click', () => { closeAllMenus(); openWsModal(); });
  $('workspace-cancel').addEventListener('click', closeWsModal);
  $('workspace-modal-close').addEventListener('click', closeWsModal);
  $('workspace-modal-overlay').addEventListener('click', closeWsModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && wsModal.style.display === 'flex') closeWsModal();
  });
  ($('workspace-form') as unknown as HTMLFormElement).addEventListener('submit', (e) => {
    e.preventDefault();
    const name = wsNameEl.value.trim();
    if (!name) { wsErr.style.display = 'block'; return; }
    const list = loadWorkspaces();
    const id = `ws-${Date.now()}`;
    list.push({ id, name, state: snapshot() });
    saveWorkspaces(list);
    localStorage.setItem(ACTIVE_WS_KEY, id);
    renderWorkspaces();
    closeWsModal();
  });

  renderWorkspaces();

  // ----- export / import (JSON) -----
  let wsStatusTimer = 0;
  function showWsStatus(msg: string, isError: boolean) {
    const el = $('ws-status');
    el.textContent = msg;
    el.style.display = 'block';
    el.className = `px-2 pt-1 text-xs ${isError ? 'text-destructive' : 'text-muted-foreground'}`;
    clearTimeout(wsStatusTimer);
    wsStatusTimer = window.setTimeout(() => { el.style.display = 'none'; }, 4000);
  }

  function downloadJSON(filename: string, text: string) {
    const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  $('ws-export').addEventListener('click', () => {
    let list = loadWorkspaces();
    // fall back to the current arrangement so export is never empty
    if (!list.length) list = [{ id: `ws-${Date.now()}`, name: 'Current', state: snapshot() }];
    const payload = { app: 'viewport', kind: 'workspaces', version: 1, exportedAt: new Date().toISOString(), workspaces: list };
    const stamp = new Date().toISOString().slice(0, 10);
    downloadJSON(`viewport-workspaces-${stamp}.json`, JSON.stringify(payload, null, 2));
    showWsStatus(`Exported ${list.length} workspace${list.length > 1 ? 's' : ''}.`, false);
  });

  const wsFile = $<HTMLInputElement>('ws-file');
  $('ws-import').addEventListener('click', () => wsFile.click());
  wsFile.addEventListener('change', async () => {
    const file = wsFile.files?.[0];
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      const incoming = Array.isArray(data) ? data : data?.workspaces;
      if (!Array.isArray(incoming)) throw new Error('no workspaces');
      const valid = incoming.filter(
        (w: any) => w && typeof w.name === 'string' && w.state && Array.isArray(w.state.devices)
      );
      if (!valid.length) throw new Error('no valid workspaces');
      const list = loadWorkspaces();
      valid.forEach((w: Workspace, i: number) =>
        list.push({ id: `ws-${Date.now()}-${i}`, name: w.name, state: w.state })
      );
      saveWorkspaces(list);
      renderWorkspaces();
      showWsStatus(`Imported ${valid.length} workspace${valid.length > 1 ? 's' : ''}.`, false);
    } catch {
      showWsStatus('Import failed — not a valid workspaces file.', true);
    } finally {
      wsFile.value = '';
    }
  });

  // ---------- screen capture (screenshot + record) ----------
  const openEditor = mountEditor();
  const canvasEl = $('canvas');
  const capStop = $('cap-stop');
  const recBadge = $('rec-badge');
  const recText = $('rec-text');
  const hostOf = (u: string) => { try { return new URL(u).hostname; } catch { return ''; } };

  let capStatusTimer = 0;
  function capStatus(msg: string, isError = false) {
    const el = $('cap-status');
    el.textContent = msg;
    el.className = `px-2 pt-1 text-xs ${isError ? 'text-destructive' : 'text-muted-foreground'}`;
    el.style.display = 'block';
    clearTimeout(capStatusTimer);
    capStatusTimer = window.setTimeout(() => { el.style.display = 'none'; }, 4000);
  }
  const syncSharing = () => { capStop.style.display = isSharing() ? 'flex' : 'none'; };

  function baseCapture(type: 'screenshot' | 'video', blob: Blob, thumb: Blob | null, width: number, height: number, durationMs: number): Capture {
    return {
      id: crypto.randomUUID(),
      type, blob, thumb, mime: blob.type,
      url: currentUrl, host: hostOf(currentUrl),
      title: formatCaptureTitle(), description: '', notes: '', annotations: [],
      durationMs, width, height, createdAt: Date.now(),
    };
  }

  if (!isSupported()) {
    ['cap-shot', 'cap-rec5', 'cap-rec10'].forEach((id) => {
      const b = $<HTMLButtonElement>(id);
      b.disabled = true;
      b.classList.add('opacity-50', 'cursor-not-allowed');
    });
  }

  async function doScreenshot() {
    closeAllMenus();
    try {
      const { blob, width, height } = await screenshot(canvasEl);
      syncSharing();
      openEditor(baseCapture('screenshot', blob, blob, width, height, 0));
    } catch {
      capStatus('Capture cancelled or blocked.', true);
    }
  }

  async function doRecord(seconds: number) {
    closeAllMenus();
    recText.textContent = `Recording… ${seconds}s`;
    recBadge.style.display = 'flex';
    try {
      const { blob, thumb, width, height, durationMs } = await record(seconds * 1000, (rem) => {
        recText.textContent = `Recording… ${Math.ceil(rem / 1000)}s`;
      });
      recBadge.style.display = 'none';
      syncSharing();
      openEditor(baseCapture('video', blob, thumb, width, height, durationMs));
    } catch {
      recBadge.style.display = 'none';
      capStatus('Recording cancelled or blocked.', true);
    }
  }

  $('cap-shot').addEventListener('click', doScreenshot);
  $('cap-rec5').addEventListener('click', () => doRecord(5));
  $('cap-rec10').addEventListener('click', () => doRecord(10));
  capStop.addEventListener('click', () => { stopSharing(); syncSharing(); closeAllMenus(); });
  syncSharing();

  // ---------- keyboard shortcuts modal ----------
  $('shortcuts-item').addEventListener('click', () => {
    closeAccountMenu();
    $('shortcuts-modal').style.display = 'flex';
  });
  $('shortcuts-close').addEventListener('click', () => { $('shortcuts-modal').style.display = 'none'; });
  $('shortcuts-overlay').addEventListener('click', () => { $('shortcuts-modal').style.display = 'none'; });
  document.addEventListener('keydown', (e) => {
    const typing = /^(input|textarea)$/i.test((e.target as HTMLElement).tagName);
    if (e.key === '?' && !typing) {
      e.preventDefault();
      $('shortcuts-modal').style.display = 'flex';
    }
    if (e.key === '/' && !typing) {
      e.preventDefault();
      input.focus();
    }
    if (e.key === 'Escape' && $('shortcuts-modal').style.display === 'flex') $('shortcuts-modal').style.display = 'none';
  });

  // ---------- logout (placeholder — no auth backend yet) ----------
  $('logout-item').addEventListener('click', () => {
    closeAccountMenu();
    // TODO: wire up real session/sign-out once auth exists
    console.info('[account] Log out clicked — no auth backend yet.');
  });

  // ?url= deep link
  const param = new URLSearchParams(location.search).get('url');
  if (param) {
    input.value = param;
    form.requestSubmit();
  }
</script>
