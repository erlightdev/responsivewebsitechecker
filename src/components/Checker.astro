---
// Device catalog, grouped Polypane-style. Panes are rendered client-side.
const groups = [
  {
    label: 'Phones',
    type: 'phone',
    icon: 'M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3',
    devices: [
      { id: 'iphone-se', name: 'iPhone SE', w: 375, h: 667, on: true },
      { id: 'iphone-15', name: 'iPhone 15 Pro', w: 393, h: 852, on: true },
      { id: 'iphone-15-max', name: 'iPhone 15 Pro Max', w: 430, h: 932, on: false },
      { id: 'pixel-8', name: 'Pixel 8', w: 412, h: 915, on: false },
      { id: 'galaxy-s24', name: 'Galaxy S24', w: 360, h: 780, on: false },
    ],
  },
  {
    label: 'Tablets',
    type: 'tablet',
    icon: 'M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-15a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z',
    devices: [
      { id: 'ipad-mini', name: 'iPad Mini', w: 768, h: 1024, on: true },
      { id: 'ipad-air', name: 'iPad Air', w: 820, h: 1180, on: false },
      { id: 'ipad-pro', name: 'iPad Pro 12.9"', w: 1024, h: 1366, on: false },
    ],
  },
  {
    label: 'Laptops & Desktops',
    type: 'desktop',
    icon: 'M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25',
    devices: [
      { id: 'macbook-air', name: 'MacBook Air', w: 1280, h: 832, on: true },
      { id: 'macbook-16', name: 'MacBook Pro 16"', w: 1536, h: 960, on: false },
      { id: 'desktop', name: 'Desktop', w: 1440, h: 900, on: false },
      { id: 'desktop-hd', name: 'Desktop HD', w: 1920, h: 1080, on: false },
    ],
  },
];
---

<div class="flex h-dvh flex-col overflow-hidden">
  <!-- ===== Toolbar ===== -->
  <header class="z-40 flex shrink-0 items-center gap-2 border-b border-border/60 bg-background/95 px-3 py-2 backdrop-blur">
    <!-- Sidebar toggle (mobile) -->
    <button type="button" id="sidebar-toggle" class="tip grid size-9 shrink-0 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Toggle device panel" data-tip="Toggle device panel" data-tip-align="start">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
    </button>

    <a href="/" class="flex shrink-0 items-center gap-2 pr-1 font-semibold tracking-tight">
      <span class="grid size-8 place-items-center rounded-md bg-primary text-primary-foreground">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      </span>
      <span class="hidden md:inline">Viewport</span>
    </a>

    <!-- URL form -->
    <form id="url-form" class="flex min-w-0 flex-1 items-center gap-2">
      <div class="flex h-9 min-w-0 flex-1 items-center gap-2 rounded-md border border-border bg-card px-3 transition-shadow focus-within:ring-2 focus-within:ring-ring/50">
        <svg class="size-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <input
          id="url-input"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          placeholder="Enter URL — e.g. example.com"
          class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        />
        <button type="button" id="clear-btn" class="tip hidden shrink-0 rounded-full p-1 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Clear URL" data-tip="Clear URL">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <button type="submit" class="h-9 shrink-0 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-transform hover:scale-[1.03]">
        <span class="hidden sm:inline">Check</span>
        <svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>

    <div class="mx-1 hidden h-6 w-px shrink-0 bg-border sm:block"></div>

    <!-- Add screen -->
    <button type="button" id="add-screen" class="tip flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-label="Add custom screen" data-tip="Add custom screen">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      <span class="hidden md:inline">Add Screen</span>
    </button>

    <!-- Layout toggle -->
    <div class="hidden shrink-0 items-center rounded-md border border-border bg-card p-0.5 sm:flex" role="group" aria-label="Canvas layout">
      <button type="button" data-layout="row" class="tip layout-btn grid size-8 place-items-center rounded-[5px] text-muted-foreground data-[on=true]:bg-muted data-[on=true]:text-foreground hover:text-foreground" data-tip="Horizontal strip" aria-label="Horizontal layout">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="5" height="12" rx="1"/><rect x="9.5" y="6" width="5" height="12" rx="1"/><rect x="17" y="6" width="5" height="12" rx="1"/></svg>
      </button>
      <button type="button" data-layout="grid" class="tip layout-btn grid size-8 place-items-center rounded-[5px] text-muted-foreground data-[on=true]:bg-muted data-[on=true]:text-foreground hover:text-foreground" data-tip="Grid layout" aria-label="Grid layout">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
      </button>
    </div>

    <!-- Device frame toggle -->
    <button type="button" id="frame-toggle" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground data-[on=true]:border-primary data-[on=true]:bg-primary/10 data-[on=true]:text-primary" data-on="true" aria-label="Toggle device frames" aria-pressed="true" data-tip="Toggle device frames">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M10 19h4"/></svg>
    </button>

    <!-- Zoom -->
    <div class="flex h-9 shrink-0 items-center rounded-md border border-border bg-card p-0.5">
      <button type="button" data-zoom-step="-1" class="tip grid size-8 place-items-center rounded-[5px] text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Zoom out" data-tip="Zoom out">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
      </button>
      <button type="button" id="zoom-label" class="tip w-12 rounded-[5px] py-1.5 text-center text-xs font-semibold tabular-nums hover:bg-muted" data-tip="Reset to fit">Fit</button>
      <button type="button" data-zoom-step="1" class="tip grid size-8 place-items-center rounded-[5px] text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Zoom in" data-tip="Zoom in">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>

    <!-- Rotate / reload all -->
    <button type="button" id="rotate-all" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Rotate all devices" data-tip="Rotate all">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
    </button>
    <button type="button" id="reload-all" class="tip hidden size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:grid" aria-label="Reload all devices" data-tip="Reload all">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
    </button>

    <!-- Theme toggle -->
    <button
      type="button"
      id="theme-toggle"
      class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      aria-label="Toggle light/dark mode"
      data-tip="Toggle theme"
      data-tip-align="end"
    >
      <!-- Sun (shown in dark mode) -->
      <svg id="icon-sun" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
      </svg>
      <!-- Moon (shown in light mode) -->
      <svg id="icon-moon" class="size-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </header>

  <div class="relative flex min-h-0 flex-1 overflow-hidden">
    <!-- ===== Sidebar ===== -->
    <aside
      id="sidebar"
      class="absolute inset-y-0 left-0 z-30 flex w-72 -translate-x-full flex-col border-r border-border/60 bg-background transition-[transform,margin] duration-300 ease-in-out data-[open=true]:translate-x-0 lg:static lg:translate-x-0 data-[collapsed=true]:lg:-ml-72 data-[collapsed=true]:lg:-translate-x-full"
      data-open="false"
      data-collapsed="false"
    >
      <div class="flex items-center justify-between px-4 pb-2 pt-4">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Devices</h2>
        <span id="device-count" class="rounded-full bg-primary/15 px-2 py-0.5 text-xs font-semibold tabular-nums text-primary">0</span>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-4 [scrollbar-width:thin]">
        {groups.map((g) => (
          <div class="mt-3 first:mt-1">
            <p class="flex items-center gap-2 px-2 pb-1.5 text-xs font-medium text-muted-foreground">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={g.icon}/></svg>
              {g.label}
            </p>
            <ul>
              {g.devices.map((d) => (
                <li>
                  <button
                    type="button"
                    class="device-row group flex w-full items-center gap-2.5 rounded-md px-2 py-2 text-left text-sm transition-colors hover:bg-muted"
                    data-id={d.id}
                    data-name={d.name}
                    data-w={d.w}
                    data-h={d.h}
                    data-type={g.type}
                    data-on={String(d.on)}
                  >
                    <span class="grid size-4 shrink-0 place-items-center rounded border border-border transition-colors group-data-[on=true]:border-primary group-data-[on=true]:bg-primary">
                      <svg class="size-3 text-primary-foreground opacity-0 transition-opacity group-data-[on=true]:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    </span>
                    <span class="min-w-0 flex-1 truncate">{d.name}</span>
                    <span class="shrink-0 text-xs tabular-nums text-muted-foreground">{d.w}×{d.h}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <!-- Custom screens (populated dynamically) -->
        <div id="custom-group" class="mt-3 hidden">
          <p class="flex items-center gap-2 px-2 pb-1.5 text-xs font-medium text-muted-foreground">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8M8 12h8"/></svg>
            Custom
          </p>
          <ul id="custom-list"></ul>
        </div>
      </div>

      <p class="border-t border-border/60 p-4 text-xs leading-relaxed text-muted-foreground">
        Sites that send <code class="rounded bg-muted px-1 py-0.5 text-[11px]">X-Frame-Options</code> headers can't be embedded and will show a notice.
      </p>
    </aside>
    <div id="sidebar-backdrop" class="absolute inset-0 z-20 hidden bg-background/60 backdrop-blur-sm lg:hidden"></div>

    <!-- ===== Canvas ===== -->
    <div
      id="canvas"
      class="min-w-0 flex-1 overflow-auto bg-[radial-gradient(circle,_var(--border)_1px,_transparent_1px)] [background-size:22px_22px]"
    >
      <!-- Empty state -->
      <div id="empty-state" class="flex h-full flex-col items-center justify-center px-6 text-center">
        <div class="grid size-16 place-items-center rounded-md bg-primary/10 text-primary">
          <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25"/></svg>
        </div>
        <h1 class="mt-6 text-2xl font-bold tracking-tight">Test any website on every screen</h1>
        <p class="mt-2 max-w-md text-sm text-muted-foreground">
          Enter a URL above and hit <span class="font-semibold text-foreground">Check</span>. Pick devices from the panel on the left.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm">
          <span class="text-muted-foreground">Try:</span>
          {['example.com', 'astro.build', 'tailwindcss.com'].map((s) => (
            <button type="button" class="sample-url rounded-full border border-border bg-card px-3 py-1 text-sm transition-colors hover:border-primary hover:text-primary" data-url={s}>{s}</button>
          ))}
        </div>
      </div>

      <!-- Panes render here -->
      <div id="frames" class="hidden"></div>
    </div>
  </div>

  <!-- ===== Add Screen modal ===== -->
  <div id="screen-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="screen-modal-title">
    <div id="screen-modal-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-sm rounded-lg border border-border bg-background p-6 shadow-xl">
      <button type="button" id="screen-modal-close" class="absolute right-4 top-4 grid size-7 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Close">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h2 id="screen-modal-title" class="text-lg font-semibold tracking-tight">Add custom screen</h2>
      <p class="mt-1 text-sm text-muted-foreground">Name it and set a viewport size — it'll be added to the sidebar.</p>
      <form id="screen-form" class="mt-5 space-y-4">
        <div class="space-y-1.5">
          <label for="screen-name" class="text-sm font-medium">Name</label>
          <input id="screen-name" type="text" placeholder="e.g. My Laptop" autocomplete="off" spellcheck="false" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm outline-none focus:ring-2 focus:ring-ring/50" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1.5">
            <label for="screen-w" class="text-sm font-medium">Width</label>
            <input id="screen-w" type="number" min="200" max="3840" placeholder="1280" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm tabular-nums outline-none focus:ring-2 focus:ring-ring/50" />
          </div>
          <div class="space-y-1.5">
            <label for="screen-h" class="text-sm font-medium">Height</label>
            <input id="screen-h" type="number" min="200" max="3840" placeholder="800" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm tabular-nums outline-none focus:ring-2 focus:ring-ring/50" />
          </div>
        </div>
        <p id="screen-error" class="hidden text-xs font-medium text-destructive">Enter a width and height between 200 and 3840.</p>
        <div class="mt-2 flex justify-end gap-2">
          <button type="button" id="screen-cancel" class="h-9 rounded-md border border-border bg-card px-4 text-sm font-medium transition-colors hover:bg-muted">Cancel</button>
          <button type="submit" class="h-9 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.03]">Add Screen</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== Delete confirmation modal ===== -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="alertdialog" aria-modal="true" aria-labelledby="delete-modal-title">
    <div id="delete-modal-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-sm rounded-lg border border-border bg-background p-6 shadow-xl">
      <h2 id="delete-modal-title" class="text-lg font-semibold tracking-tight">Delete screen?</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        <span id="delete-modal-name" class="font-medium text-foreground"></span> will be removed from the sidebar and canvas. This can't be undone.
      </p>
      <div class="mt-6 flex justify-end gap-2">
        <button type="button" id="delete-cancel" class="h-9 rounded-md border border-border bg-card px-4 text-sm font-medium transition-colors hover:bg-muted">Cancel</button>
        <button type="button" id="delete-confirm" class="h-9 rounded-md bg-destructive px-4 text-sm font-semibold text-white transition-transform hover:scale-[1.03]">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  // ---------- state ----------
  type Device = { id: string; name: string; w: number; h: number; type: string; rotated: boolean };
  type Layout = 'row' | 'grid';

  let currentUrl = '';
  let zoom: number | 'fit' = 'fit';
  let layout: Layout = 'row';
  let framesOn = true;
  let customCount = 0;
  const active = new Map<string, Device>();
  const customScreens = new Map<string, Device>(); // user-defined screen definitions

  // ---------- elements ----------
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $('url-form') as unknown as HTMLFormElement;
  const input = $<HTMLInputElement>('url-input');
  const clearBtn = $('clear-btn');
  const frames = $('frames');
  const emptyState = $('empty-state');
  const zoomLabel = $('zoom-label');
  const deviceCount = $('device-count');
  const sidebar = $('sidebar');
  const backdrop = $('sidebar-backdrop');

  // ---------- persistence ----------
  const store = {
    save() {
      try {
        localStorage.setItem('vp-state', JSON.stringify({
          layout,
          zoom,
          framesOn,
          devices: [...active.values()],
          customScreens: [...customScreens.values()],
        }));
      } catch { /* private mode etc. */ }
    },
    load() {
      try {
        const raw = localStorage.getItem('vp-state');
        if (!raw) return null;
        return JSON.parse(raw) as { layout: Layout; zoom: number | 'fit'; framesOn?: boolean; devices: Device[]; customScreens?: Device[] };
      } catch {
        return null;
      }
    },
  };

  // ---------- init devices ----------
  const trackCustomCount = (id: string) => {
    if (id.startsWith('custom-')) customCount = Math.max(customCount, Number(id.split('-')[1]) || 0);
  };
  const saved = store.load();
  if (saved) {
    layout = saved.layout === 'grid' ? 'grid' : 'row';
    zoom = saved.zoom === 'fit' || typeof saved.zoom === 'number' ? saved.zoom : 'fit';
    framesOn = saved.framesOn !== false;
    saved.customScreens?.forEach((d) => { customScreens.set(d.id, d); trackCustomCount(d.id); });
  }
  if (saved?.devices?.length) {
    saved.devices.forEach((d) => {
      active.set(d.id, d);
      trackCustomCount(d.id);
      // migrate older saves where custom devices weren't tracked separately
      if (d.id.startsWith('custom-') && !customScreens.has(d.id)) customScreens.set(d.id, { ...d, rotated: false });
    });
  } else if (!saved) {
    document.querySelectorAll<HTMLButtonElement>('.device-row[data-on="true"]').forEach((row) => {
      active.set(row.dataset.id!, {
        id: row.dataset.id!,
        name: row.dataset.name!,
        w: Number(row.dataset.w),
        h: Number(row.dataset.h),
        type: row.dataset.type!,
        rotated: false,
      });
    });
  }
  // sync built-in sidebar checkmarks with state (custom rows are built later)
  document.querySelectorAll<HTMLButtonElement>('.device-row').forEach((row) => {
    row.dataset.on = String(active.has(row.dataset.id!));
  });

  // ---------- helpers ----------
  function normalizeUrl(raw: string): string | null {
    let v = raw.trim();
    if (!v) return null;
    if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
    try {
      const u = new URL(v);
      if (!u.hostname.includes('.') && u.hostname !== 'localhost') return null;
      return u.href;
    } catch {
      return null;
    }
  }

  function fitScale(w: number): number {
    if (w <= 500) return 0.72; // phones
    if (w <= 1100) return 0.48; // tablets
    return 0.36; // laptops / desktops
  }
  const scaleFor = (w: number) => (zoom === 'fit' ? fitScale(w) : zoom);

  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  // Build a same-origin proxy URL whose path mirrors the target's, so SPA
  // routers (which branch on location.pathname) see the real route. The target
  // origin rides along in a __vphost marker the proxy middleware reads.
  function toProxy(raw: string): string {
    try {
      const u = new URL(raw);
      const params = new URLSearchParams(u.search);
      params.set('__vphost', u.origin);
      return `${u.pathname}?${params.toString()}${u.hash}`;
    } catch {
      return raw;
    }
  }

  // ---------- pane rendering ----------
  function pane(d: Device): HTMLElement {
    const w = d.rotated ? d.h : d.w;
    const h = d.rotated ? d.w : d.h;
    const s = scaleFor(w);
    const sw = Math.round(w * s);
    const sh = Math.round(h * s);
    const name = escapeHtml(d.name);

    const el = document.createElement('div');
    el.className = 'flex shrink-0 flex-col';
    el.dataset.frameId = d.id;

    // screen = overlays + iframe; skin differs per device type
    const screen = `
      <div class="relative overflow-hidden bg-card" data-role="screen" style="width:${sw}px;height:${sh}px">
        <div data-role="loader" class="absolute inset-0 z-10 grid place-items-center bg-card">
          <div class="size-6 animate-spin rounded-full border-2 border-muted border-t-primary"></div>
        </div>
        <iframe
          title="${name} preview"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
          loading="lazy"
          style="width:${w}px;height:${h}px;transform:scale(${s});transform-origin:top left;border:0"
        ></iframe>
      </div>
    `;

    let skin: string;
    if (!framesOn) {
      // bare screen — no device chrome
      skin = `<div class="overflow-hidden rounded-md border border-border/70 shadow-lg">${screen}</div>`;
    } else if (d.type === 'phone') {
      skin = `
        <div class="rounded-[2rem] border border-border/70 bg-neutral-950 p-2 ${d.rotated ? 'pl-5' : 'pt-5'} shadow-2xl dark:bg-black">
          ${d.rotated
            ? '<div class="absolute left-2 top-1/2 h-12 w-1 -translate-y-1/2 rounded-full bg-neutral-800"></div>'
            : '<div class="absolute left-1/2 top-2 h-1 w-12 -translate-x-1/2 rounded-full bg-neutral-800"></div>'}
          <div class="overflow-hidden rounded-[1.4rem]">${screen}</div>
        </div>
      `;
    } else if (d.type === 'tablet') {
      skin = `
        <div class="rounded-[1.4rem] border border-border/70 bg-neutral-950 p-2.5 shadow-2xl dark:bg-black">
          <div class="overflow-hidden rounded-[0.9rem]">${screen}</div>
        </div>
      `;
    } else {
      // browser chrome for laptop / desktop / custom
      skin = `
        <div class="overflow-hidden rounded-lg border border-border/70 bg-card shadow-2xl">
          <div class="flex items-center gap-2 border-b border-border/60 bg-muted/40 px-3 py-1.5">
            <span class="flex gap-1.5">
              <span class="size-2.5 rounded-full bg-destructive/60"></span>
              <span class="size-2.5 rounded-full bg-chart-3/60"></span>
              <span class="size-2.5 rounded-full bg-primary/60"></span>
            </span>
            <span data-role="chrome-url" class="min-w-0 flex-1 truncate rounded bg-background/70 px-2 py-0.5 text-[10px] text-muted-foreground"></span>
          </div>
          ${screen}
        </div>
      `;
    }

    el.innerHTML = `
      <div class="mb-2 flex items-center justify-between gap-2 px-0.5" style="width:${sw + (!framesOn || d.type === 'desktop' ? 2 : 20)}px">
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold">${name}</p>
          <p class="text-xs tabular-nums text-muted-foreground">${w} × ${h} · ${Math.round(s * 100)}%</p>
        </div>
        <div class="flex shrink-0 items-center gap-0.5">
          <button type="button" data-action="rotate" class="grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Rotate ${name}" title="Rotate">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/></svg>
          </button>
          <button type="button" data-action="reload" class="grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Reload ${name}" title="Reload">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
          </button>
          <a data-action="open" href="${escapeHtml(currentUrl)}" target="_blank" rel="noopener noreferrer" class="grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Open ${name} in new tab" title="Open in new tab">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
          <button type="button" data-action="close" class="grid size-7 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-destructive" aria-label="Remove ${name}" title="Remove">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div class="relative">${skin}</div>
    `;

    const iframe = el.querySelector('iframe')!;
    const loader = el.querySelector<HTMLElement>('[data-role="loader"]')!;
    const chromeUrl = el.querySelector<HTMLElement>('[data-role="chrome-url"]');
    if (chromeUrl) chromeUrl.textContent = currentUrl.replace(/^https?:\/\//, '');

    const startLoad = () => {
      loader.style.display = 'grid';
      iframe.src = toProxy(currentUrl);
      iframe.addEventListener('load', () => { loader.style.display = 'none'; }, { once: true });
    };
    startLoad();

    el.querySelector('[data-action="reload"]')!.addEventListener('click', startLoad);
    el.querySelector('[data-action="rotate"]')!.addEventListener('click', () => {
      d.rotated = !d.rotated;
      el.replaceWith(pane(d));
      store.save();
    });
    el.querySelector('[data-action="close"]')!.addEventListener('click', () => {
      removeDevice(d.id);
    });

    return el;
  }

  // ---------- canvas ----------
  function applyLayout() {
    frames.className =
      layout === 'row'
        ? 'flex w-max min-w-full items-start gap-10 px-8 py-7'
        : 'flex flex-wrap items-start justify-center gap-10 px-8 py-7';
    document.querySelectorAll<HTMLButtonElement>('.layout-btn').forEach((b) => {
      b.dataset.on = String(b.dataset.layout === layout);
    });
  }

  function renderAll() {
    if (!currentUrl) return;
    frames.innerHTML = '';
    active.forEach((d) => frames.appendChild(pane(d)));
    emptyState.style.display = 'none';
    applyLayout();
    updateCount();
  }

  function updateCount() {
    deviceCount.textContent = String(active.size);
  }

  function addDevice(d: Device) {
    active.set(d.id, d);
    const row = document.querySelector<HTMLElement>(`.device-row[data-id="${d.id}"]`);
    if (row) row.dataset.on = 'true';
    if (currentUrl) frames.appendChild(pane(d));
    updateCount();
    store.save();
  }

  function removeDevice(id: string) {
    active.delete(id);
    const row = document.querySelector<HTMLElement>(`.device-row[data-id="${id}"]`);
    if (row) row.dataset.on = 'false';
    frames.querySelector(`[data-frame-id="${id}"]`)?.remove();
    updateCount();
    store.save();
  }

  // ---------- events ----------
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = normalizeUrl(input.value);
    if (!url) {
      input.focus();
      input.classList.add('text-destructive');
      setTimeout(() => input.classList.remove('text-destructive'), 1200);
      return;
    }
    currentUrl = url;
    input.value = url;
    clearBtn.style.display = 'block';
    closeSidebar();
    renderAll();
  });

  input.addEventListener('input', () => {
    clearBtn.style.display = input.value ? 'block' : 'none';
  });
  clearBtn.addEventListener('click', () => {
    input.value = '';
    clearBtn.style.display = 'none';
    input.focus();
  });

  document.querySelectorAll<HTMLButtonElement>('.sample-url').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.url!;
      form.requestSubmit();
    })
  );

  // toggle a device on/off from its sidebar row (built-in or custom)
  function toggleRow(row: HTMLElement) {
    const id = row.dataset.id!;
    if (active.has(id)) {
      removeDevice(id);
    } else {
      addDevice({
        id,
        name: row.dataset.name!,
        w: Number(row.dataset.w),
        h: Number(row.dataset.h),
        type: row.dataset.type!,
        rotated: false,
      });
    }
  }

  // sidebar device rows (built-in)
  document.querySelectorAll<HTMLButtonElement>('.device-row').forEach((row) =>
    row.addEventListener('click', () => toggleRow(row))
  );

  // ---------- custom screens ----------
  const customList = $('custom-list');
  const customGroup = $('custom-group');

  const typeForWidth = (w: number) => (w <= 500 ? 'phone' : w <= 1100 ? 'tablet' : 'desktop');

  function syncCustomGroup() {
    customGroup.style.display = customScreens.size ? 'block' : 'none';
  }

  // Build + insert a sidebar row for a custom screen definition.
  function insertCustomRow(d: Device) {
    const name = escapeHtml(d.name);
    const li = document.createElement('li');
    li.dataset.customId = d.id;
    li.innerHTML = `
      <div class="device-row group flex w-full items-center gap-2 rounded-md px-2 py-2 text-left text-sm transition-colors hover:bg-muted"
        role="button" tabindex="0"
        data-id="${d.id}" data-name="${name}" data-w="${d.w}" data-h="${d.h}" data-type="${d.type}" data-on="${String(active.has(d.id))}">
        <span class="grid size-4 shrink-0 place-items-center rounded border border-border transition-colors group-data-[on=true]:border-primary group-data-[on=true]:bg-primary">
          <svg class="size-3 text-primary-foreground opacity-0 transition-opacity group-data-[on=true]:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <span class="min-w-0 flex-1 truncate">${name}</span>
        <span class="shrink-0 text-xs tabular-nums text-muted-foreground">${d.w}×${d.h}</span>
        <button type="button" class="custom-del grid size-5 shrink-0 place-items-center rounded text-muted-foreground opacity-0 transition-opacity hover:text-destructive focus-visible:opacity-100 group-hover:opacity-100" aria-label="Delete ${name}" title="Delete screen">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
        </button>
      </div>`;
    const row = li.querySelector<HTMLElement>('.device-row')!;
    const del = li.querySelector<HTMLButtonElement>('.custom-del')!;
    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.custom-del')) return;
      toggleRow(row);
    });
    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRow(row); }
    });
    del.addEventListener('click', (e) => { e.stopPropagation(); promptDeleteScreen(d.id); });
    customList.appendChild(li);
    syncCustomGroup();
  }

  function deleteCustomScreen(id: string) {
    if (active.has(id)) removeDevice(id);
    customScreens.delete(id);
    customList.querySelector(`li[data-custom-id="${id}"]`)?.remove();
    syncCustomGroup();
    store.save();
  }

  function addCustomScreen(name: string, w: number, h: number) {
    customCount += 1;
    const d: Device = {
      id: `custom-${customCount}`,
      name: name.trim() || `Custom ${w}×${h}`,
      w, h,
      type: typeForWidth(w),
      rotated: false,
    };
    customScreens.set(d.id, d);
    insertCustomRow(d);
    addDevice(d); // activate + render + persist
  }

  // ---------- Add Screen modal ----------
  const modal = $('screen-modal');
  const nameEl = $<HTMLInputElement>('screen-name');
  const wEl = $<HTMLInputElement>('screen-w');
  const hEl = $<HTMLInputElement>('screen-h');
  const errEl = $('screen-error');

  function openModal() {
    nameEl.value = '';
    wEl.value = '';
    hEl.value = '';
    errEl.style.display = 'none';
    modal.style.display = 'flex';
    setTimeout(() => nameEl.focus(), 0);
  }
  function closeModal() {
    modal.style.display = 'none';
  }

  $('add-screen').addEventListener('click', openModal);
  $('screen-cancel').addEventListener('click', closeModal);
  $('screen-modal-close').addEventListener('click', closeModal);
  $('screen-modal-overlay').addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
  });

  ($('screen-form') as unknown as HTMLFormElement).addEventListener('submit', (e) => {
    e.preventDefault();
    const w = Number(wEl.value);
    const h = Number(hEl.value);
    if (!w || !h || w < 200 || w > 3840 || h < 200 || h > 3840) {
      errEl.style.display = 'block';
      return;
    }
    addCustomScreen(nameEl.value, w, h);
    closeModal();
  });

  // ---------- Delete confirmation modal ----------
  const deleteModal = $('delete-modal');
  const deleteNameEl = $('delete-modal-name');
  let pendingDeleteId: string | null = null;

  function promptDeleteScreen(id: string) {
    pendingDeleteId = id;
    deleteNameEl.textContent = customScreens.get(id)?.name ?? 'This screen';
    deleteModal.style.display = 'flex';
    setTimeout(() => $('delete-cancel').focus(), 0);
  }
  function closeDeleteModal() {
    deleteModal.style.display = 'none';
    pendingDeleteId = null;
  }

  $('delete-cancel').addEventListener('click', closeDeleteModal);
  $('delete-modal-overlay').addEventListener('click', closeDeleteModal);
  $('delete-confirm').addEventListener('click', () => {
    if (pendingDeleteId) deleteCustomScreen(pendingDeleteId);
    closeDeleteModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && deleteModal.style.display === 'flex') closeDeleteModal();
  });

  // layout
  document.querySelectorAll<HTMLButtonElement>('.layout-btn').forEach((b) =>
    b.addEventListener('click', () => {
      layout = (b.dataset.layout as Layout) ?? 'row';
      applyLayout();
      store.save();
    })
  );

  // zoom
  const ZOOMS = [0.25, 0.36, 0.5, 0.65, 0.8, 1];
  function setZoom(z: number | 'fit') {
    zoom = z;
    zoomLabel.textContent = z === 'fit' ? 'Fit' : `${Math.round(z * 100)}%`;
    store.save();
    renderAll();
  }
  zoomLabel.addEventListener('click', () => setZoom('fit'));
  document.querySelectorAll<HTMLButtonElement>('[data-zoom-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const dir = Number(b.dataset.zoomStep);
      const cur = zoom === 'fit' ? 0.5 : zoom;
      const idx = ZOOMS.findIndex((z) => z >= cur - 0.001);
      const next = ZOOMS[Math.min(ZOOMS.length - 1, Math.max(0, (idx === -1 ? 2 : idx) + dir))];
      setZoom(next);
    })
  );

  // device frame toggle
  const frameToggle = $('frame-toggle');
  function syncFrameToggle() {
    frameToggle.dataset.on = String(framesOn);
    frameToggle.setAttribute('aria-pressed', String(framesOn));
  }
  frameToggle.addEventListener('click', () => {
    framesOn = !framesOn;
    syncFrameToggle();
    store.save();
    renderAll();
  });

  // rotate / reload all
  $('rotate-all').addEventListener('click', () => {
    active.forEach((d) => (d.rotated = !d.rotated));
    store.save();
    renderAll();
  });
  $('reload-all').addEventListener('click', renderAll);

  // sidebar — drawer on mobile, collapse on desktop
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

  function closeSidebar() {
    sidebar.dataset.open = 'false';
    backdrop.style.display = 'none';
  }
  $('sidebar-toggle').addEventListener('click', () => {
    if (isDesktop()) {
      const collapsed = sidebar.dataset.collapsed !== 'true';
      sidebar.dataset.collapsed = String(collapsed);
      try { localStorage.setItem('vp-sidebar', collapsed ? 'collapsed' : 'open'); } catch { /* private mode */ }
    } else {
      const open = sidebar.dataset.open !== 'true';
      sidebar.dataset.open = String(open);
      backdrop.style.display = open ? 'block' : 'none';
    }
  });
  backdrop.addEventListener('click', closeSidebar);

  // restore desktop collapse preference
  try {
    if (localStorage.getItem('vp-sidebar') === 'collapsed') sidebar.dataset.collapsed = 'true';
  } catch { /* private mode */ }

  // init UI state
  applyLayout();
  syncFrameToggle();
  customScreens.forEach((d) => insertCustomRow(d)); // rebuild saved custom screens
  zoomLabel.textContent = zoom === 'fit' ? 'Fit' : `${Math.round((zoom as number) * 100)}%`;
  updateCount();

  // ---------- theme toggle ----------
  const sunIcon  = $('icon-sun');
  const moonIcon = $('icon-moon');

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    // dark mode → show sun (click to go light); light mode → show moon (click to go dark)
    sunIcon.classList.toggle('hidden', !isDark);
    moonIcon.classList.toggle('hidden', isDark);
  }
  syncThemeIcons();

  $('theme-toggle').addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('vp-theme', isDark ? 'dark' : 'light');
    syncThemeIcons();
  });

  // ?url= deep link
  const param = new URLSearchParams(location.search).get('url');
  if (param) {
    input.value = param;
    form.requestSubmit();
  }
</script>

<style>
  /* shadcn-style tooltip (new-york-v4 look) — dependency-free, attribute-driven.
     Usage: add class `tip` + `data-tip="text"` to any element. Optional
     `data-tip-align="start|end"` keeps edge triggers from clipping the viewport. */
  .tip {
    position: relative;
  }
  .tip::before,
  .tip::after {
    position: absolute;
    left: 50%;
    z-index: 60;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, transform 120ms ease;
  }
  /* bubble */
  .tip::after {
    content: attr(data-tip);
    top: calc(100% + 7px);
    transform: translate(-50%, -3px) scale(0.96);
    transform-origin: top center;
    white-space: nowrap;
    border-radius: calc(var(--radius) - 2px);
    background: var(--primary);
    color: var(--primary-foreground);
    padding: 0.375rem 0.625rem;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    box-shadow: 0 8px 20px -6px rgb(0 0 0 / 0.3);
  }
  /* arrow */
  .tip::before {
    content: "";
    top: calc(100% + 3px);
    width: 0.5rem;
    height: 0.5rem;
    background: var(--primary);
    border-radius: 2px;
    transform: translate(-50%, -3px) rotate(45deg);
  }
  .tip:hover::after,
  .tip:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
  .tip:hover::before,
  .tip:focus-visible::before {
    opacity: 1;
    transform: translate(-50%, 0) rotate(45deg);
  }
  /* edge-aligned bubbles (arrow stays over the trigger center) */
  .tip[data-tip-align="start"]::after {
    left: 0;
    transform: translate(0, -3px) scale(0.96);
    transform-origin: top left;
  }
  .tip[data-tip-align="start"]:hover::after,
  .tip[data-tip-align="start"]:focus-visible::after {
    transform: translate(0, 0) scale(1);
  }
  .tip[data-tip-align="end"]::after {
    left: auto;
    right: 0;
    transform: translate(0, -3px) scale(0.96);
    transform-origin: top right;
  }
  .tip[data-tip-align="end"]:hover::after,
  .tip[data-tip-align="end"]:focus-visible::after {
    transform: translate(0, 0) scale(1);
  }
</style>
