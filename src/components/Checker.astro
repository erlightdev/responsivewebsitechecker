  });

  frames.addEventListener('dragover', (e) => {
    e.preventDefault();
    e.dataTransfer!.dropEffect = 'move';
    const dragging = frames.querySelector('.dragging');
    if (!dragging) return;
    
    const x = e.clientX, y = e.clientY;
    let best = null;
    for (const item of dragCache) {
      const cx = item.box.left + item.box.width / 2, cy = item.box.top + item.box.height / 2, dist = Math.hypot(x - cx, y - cy);
