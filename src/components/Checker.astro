---
import CaptureEditor from './CaptureEditor.astro';
// Device catalog, grouped Polypane-style. Panes are rendered client-side.
const groups = [
  {
    label: 'Phones',
    type: 'phone',
    icon: 'M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3',
    devices: [
      { id: 'iphone-se', name: 'iPhone SE', w: 375, h: 667, on: true },
      { id: 'iphone-15', name: 'iPhone 15 Pro', w: 393, h: 852, on: true },
      { id: 'iphone-15-max', name: 'iPhone 15 Pro Max', w: 430, h: 932, on: false },
      { id: 'pixel-8', name: 'Pixel 8', w: 412, h: 915, on: false },
      { id: 'galaxy-s24', name: 'Galaxy S24', w: 360, h: 780, on: false },
    ],
  },
  {
    label: 'Tablets',
    type: 'tablet',
    icon: 'M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-15a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z',
    devices: [
      { id: 'ipad-mini', name: 'iPad Mini', w: 768, h: 1024, on: true },
      { id: 'ipad-air', name: 'iPad Air', w: 820, h: 1180, on: false },
      { id: 'ipad-pro', name: 'iPad Pro 12.9"', w: 1024, h: 1366, on: false },
    ],
  },
  {
    label: 'Laptops & Desktops',
    type: 'desktop',
    icon: 'M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25',
    devices: [
      { id: 'macbook-air', name: 'MacBook Air', w: 1280, h: 832, on: true },
      { id: 'macbook-16', name: 'MacBook Pro 16"', w: 1536, h: 960, on: false },
      { id: 'desktop', name: 'Desktop', w: 1440, h: 900, on: false },
      { id: 'desktop-hd', name: 'Desktop HD', w: 1920, h: 1080, on: false },
    ],
  },
];
---

<div class="flex h-dvh flex-col overflow-hidden">
  <!-- ===== Toolbar ===== -->
  <header class="z-40 flex shrink-0 items-center gap-2 border-b border-border/60 bg-background/95 px-3 py-2 backdrop-blur">
    <!-- Sidebar toggle (mobile) -->
    <button type="button" id="sidebar-toggle" class="tip grid size-9 shrink-0 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Toggle device panel" data-tip="Toggle device panel" data-tip-align="start">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
    </button>

    <a href="/checker" class="flex shrink-0 items-center gap-2 pr-1 font-semibold tracking-tight">
      <span class="grid size-8 place-items-center rounded-md bg-primary text-primary-foreground">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      </span>
      <span class="hidden md:inline">Viewport</span>
    </a>

    <!-- URL form -->
    <form id="url-form" class="flex min-w-0 flex-1 items-center gap-2">
      <div class="flex h-9 min-w-0 flex-1 items-center gap-2 rounded-md border border-border bg-card px-3 transition-shadow focus-within:ring-2 focus-within:ring-ring/50">
        <svg class="size-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <input
          id="url-input"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          placeholder="Enter URL — e.g. example.com"
          class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        />
        <button type="button" id="clear-btn" class="tip hidden shrink-0 rounded-full p-1 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Clear URL" data-tip="Clear URL">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <button type="submit" class="h-9 shrink-0 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-transform hover:scale-[1.03]">
        <span class="hidden sm:inline">Check</span>
        <svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>

    <!-- Clear cache (fixed rose tint, theme-independent) -->
    <button type="button" id="clear-cache" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-rose-500/40 bg-rose-500/5 text-rose-500 transition-colors hover:bg-rose-500/15 hover:text-rose-600 dark:text-rose-400 dark:hover:text-rose-300" aria-label="Clear cache and soft-reload all devices" data-tip="Clear cache & reload">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 5v6c0 1.66-4 3-9 3s-9-1.34-9-3V5"/><path d="M21 11v6c0 1.66-4 3-9 3s-9-1.34-9-3v-6"/></svg>
    </button>

    <div class="mx-1 hidden h-6 w-px shrink-0 bg-border sm:block"></div>

    <!-- Add screen -->
    <button type="button" id="add-screen" class="tip flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-label="Add custom screen" data-tip="Add custom screen">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      <span class="hidden md:inline">Add Screen</span>
    </button>

    <!-- Workspaces -->
    <div class="relative shrink-0">
      <button type="button" id="workspace-btn" class="tip flex h-9 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-haspopup="menu" aria-expanded="false" aria-label="Workspaces" data-tip="Workspaces">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5-9 4.5-9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/></svg>
        <span class="hidden md:inline">Workspaces</span>
      </button>

      <div id="workspace-menu" class="absolute left-0 top-full z-50 mt-2 hidden w-64 origin-top-left rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md" role="menu" aria-labelledby="workspace-btn">
        <button type="button" id="ws-save" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm font-medium text-primary outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
          Save current workspace…
        </button>
        <a href="/workspaces" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          View all workspaces
        </a>
        <div class="-mx-1 my-1 h-px bg-border"></div>
        <p class="px-2 pb-1 pt-0.5 text-xs font-medium text-muted-foreground">Saved workspaces</p>
        <ul id="ws-list" class="max-h-64 overflow-auto"></ul>
        <p id="ws-empty" class="px-2 py-2 text-xs text-muted-foreground">No saved workspaces yet.</p>

        <div class="-mx-1 my-1 h-px bg-border"></div>
        <button type="button" id="ws-export" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
          Export workspaces (JSON)
        </button>
        <button type="button" id="ws-import" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 9l5-5 5 5"/><path d="M12 4v12"/></svg>
          Import workspaces…
        </button>
        <input id="ws-file" type="file" accept="application/json,.json" class="hidden" />
        <p id="ws-status" class="hidden px-2 pt-1 text-xs"></p>
      </div>
    </div>

    <!-- Social preview -->
    <a href="/social" class="tip flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-label="Social preview" data-tip="Social preview">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg>
      <span class="hidden md:inline">Social</span>
    </a>

    <!-- Capture -->
    <div class="relative shrink-0">
      <button type="button" id="capture-btn" class="tip flex h-9 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-haspopup="menu" aria-expanded="false" aria-label="Capture" data-tip="Screenshot & record">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
        <span class="hidden md:inline">Capture</span>
      </button>

      <div id="capture-menu" class="absolute left-0 top-full z-50 mt-2 hidden w-60 origin-top-left rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md" role="menu" aria-labelledby="capture-btn">
        <button type="button" id="cap-shot" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          Screenshot
        </button>
        <button type="button" id="cap-rec5" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
          Record 5s
        </button>
        <button type="button" id="cap-rec10" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
          Record 10s
        </button>
        <div class="-mx-1 my-1 h-px bg-border"></div>
        <a href="/captures" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5L9 20"/></svg>
          View captures
        </a>
        <button type="button" id="cap-stop" role="menuitem" class="menu-item hidden w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm text-muted-foreground outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
          Stop screen sharing
        </button>
        <p id="cap-status" class="hidden px-2 pt-1 text-xs"></p>
      </div>
    </div>

    <!-- Layout toggle -->
    <div class="hidden shrink-0 items-center rounded-md border border-border bg-card p-0.5 sm:flex" role="group" aria-label="Canvas layout">
      <button type="button" data-layout="row" class="tip layout-btn grid size-8 place-items-center rounded-[5px] text-muted-foreground data-[on=true]:bg-muted data-[on=true]:text-foreground hover:text-foreground" data-tip="Horizontal strip" aria-label="Horizontal layout">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="5" height="12" rx="1"/><rect x="9.5" y="6" width="5" height="12" rx="1"/><rect x="17" y="6" width="5" height="12" rx="1"/></svg>
      </button>
      <button type="button" data-layout="grid" class="tip layout-btn grid size-8 place-items-center rounded-[5px] text-muted-foreground data-[on=true]:bg-muted data-[on=true]:text-foreground hover:text-foreground" data-tip="Grid layout" aria-label="Grid layout">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
      </button>
    </div>

    <!-- Device frame toggle -->
    <button type="button" id="frame-toggle" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground data-[on=true]:border-primary data-[on=true]:bg-primary/10 data-[on=true]:text-primary" data-on="true" aria-label="Toggle device frames" aria-pressed="true" data-tip="Toggle device frames">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M10 19h4"/></svg>
    </button>

    <!-- Zoom -->
    <div class="flex h-9 shrink-0 items-center rounded-md border border-border bg-card p-0.5">
      <button type="button" data-zoom-step="-1" class="tip grid size-8 place-items-center rounded-[5px] text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Zoom out" data-tip="Zoom out">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
      </button>
      <button type="button" id="zoom-label" class="tip w-12 rounded-[5px] py-1.5 text-center text-xs font-semibold tabular-nums hover:bg-muted" data-tip="Reset to fit">Fit</button>
      <button type="button" data-zoom-step="1" class="tip grid size-8 place-items-center rounded-[5px] text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Zoom in" data-tip="Zoom in">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>

    <!-- Rotate / reload all -->
    <button type="button" id="rotate-all" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Rotate all devices" data-tip="Rotate all">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
    </button>
    <button type="button" id="reload-all" class="tip hidden size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:grid" aria-label="Reload all devices" data-tip="Reload all">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
    </button>

    <!-- Theme menu -->
    <div class="relative shrink-0">
      <button
        type="button"
        id="theme-btn"
        class="tip grid size-9 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Open theme menu"
        aria-haspopup="menu"
        aria-expanded="false"
        data-tip="Theme"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.012 17.5 2 12 2z"/></svg>
      </button>

      <!-- Theme dropdown -->
      <div
        id="theme-menu"
        class="absolute right-0 top-full z-50 mt-2 hidden w-56 origin-top-right rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
        role="menu"
        aria-labelledby="theme-btn"
      >
        <p class="px-2 pb-1 pt-1.5 text-xs font-medium text-muted-foreground">Theme</p>
        <div class="grid grid-cols-3 gap-1 px-1">
          <button type="button" data-theme-mode="light" role="menuitemradio" aria-checked="false" class="theme-mode flex flex-col items-center gap-1 rounded-sm border border-transparent px-1 py-2 text-xs outline-none hover:bg-accent hover:text-accent-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            Light
          </button>
          <button type="button" data-theme-mode="dark" role="menuitemradio" aria-checked="false" class="theme-mode flex flex-col items-center gap-1 rounded-sm border border-transparent px-1 py-2 text-xs outline-none hover:bg-accent hover:text-accent-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            Dark
          </button>
          <button type="button" data-theme-mode="system" role="menuitemradio" aria-checked="false" class="theme-mode flex flex-col items-center gap-1 rounded-sm border border-transparent px-1 py-2 text-xs outline-none hover:bg-accent hover:text-accent-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            System
          </button>
        </div>

        <div class="-mx-1 my-1 h-px bg-border"></div>
