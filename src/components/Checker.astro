<!-- Annotation editor (shared) -->
<CaptureEditor />

<script>
  import { screenshot, record, isSupported, isSharing, stopSharing } from '../lib/capture-media';
  import { mountEditor } from '../lib/capture-editor';
  import type { Capture } from '../lib/captures-db';
  import { toast } from '../lib/toast';
  import { signOut } from '../lib/auth-client';

  // ---------- DOM Utilities ----------
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const $$ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel));

  // ---------- Safe Storage ----------
  const safeStore = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} },
    remove: (k: string) => { try { localStorage.removeItem(k); } catch {} },
    clearKeys: (prefix: string) => { try { Object.keys(localStorage).forEach(k => k.startsWith(prefix) && localStorage.removeItem(k)); } catch {} }
  };

  // ---------- State ----------
  type Device = { id: string; name: string; w: number; h: number; type: string; rotated: boolean };
  type Layout = 'row' | 'grid';

  let currentUrl = '';
  let zoom: number | 'fit' = 'fit';
  let layout: Layout = 'row';
  let framesOn = true;
  let customCount = 0;
  const active = new Map<string, Device>();
  const customScreens = new Map<string, Device>();
  type PageMeta = { url: string; title: string; pageName: string; updatedAt: number };
  let latestPageMeta: PageMeta | null = null;

  // ---------- Elements ----------
  const form = $('url-form') as HTMLFormElement;
  const input = $<HTMLInputElement>('url-input');
  const clearBtn = $('clear-btn');
  const frames = $('frames');
  const emptyState = $('empty-state');
  const zoomLabel = $('zoom-label');
  const deviceCount = $('device-count');
  const sidebar = $('sidebar');
  const backdrop = $('sidebar-backdrop');

  // ---------- Tier limits & Promo ----------
  const root = document.querySelector<HTMLElement>('[data-max-screens]');
  const MAX_SCREENS = Number(root?.dataset.maxScreens) || Infinity;
  const SCREEN_TIER = root?.dataset.screenTier || 'guest';
  const CAN_PRO = root?.dataset.canPro === 'true';

  function limitMessage() {
    if (SCREEN_TIER === 'guest') return { msg: `Free preview is limited to ${MAX_SCREENS} screens`, desc: 'Sign up free to use up to 6.' };
    return { msg: `Your plan is limited to ${MAX_SCREENS} screens`, desc: 'Upgrade to Pro for unlimited screens.' };
  }
  function canAddScreen(): boolean {
    if (active.size < MAX_SCREENS) return true;
    const { msg, desc } = limitMessage();
    toast.warning(msg, { description: desc, log: false });
    return false;
  }
  function proToast(feature: string) {
    toast.warning(`${feature} is a Pro feature`, {
      description: SCREEN_TIER === 'guest' ? 'Sign up and upgrade to Pro to unlock.' : 'Upgrade to Pro to unlock.', log: false
    });
  }

  // Guest promo logic
  if (SCREEN_TIER === 'guest') {
    const promo = $('promo-cta');
    const plansModal = $('plans-modal');
    const plansPanel = $('plans-panel');
    const plansOverlay = $('plans-overlay');

    const showPromo = () => { promo.classList.replace('hidden', 'flex'); requestAnimationFrame(() => promo.classList.remove('translate-y-2', 'opacity-0')); };
    const hidePromo = () => { promo.classList.add('translate-y-2', 'opacity-0'); setTimeout(() => promo.classList.replace('flex', 'hidden'), 300); };

    let plansOpen = false;
    const openPlans = () => { plansOpen = true; hidePromo(); plansModal.classList.replace('hidden', 'flex'); requestAnimationFrame(() => { plansOverlay.classList.remove('opacity-0'); plansPanel.classList.remove('scale-95', 'opacity-0'); }); };
    const closePlans = () => { plansOpen = false; plansOverlay.classList.add('opacity-0'); plansPanel.classList.add('scale-95', 'opacity-0'); setTimeout(() => { plansModal.classList.replace('flex', 'hidden'); showPromo(); }, 200); };

    $('promo-open').addEventListener('click', openPlans); $('promo-dismiss').addEventListener('click', hidePromo);
    $('plans-close').addEventListener('click', closePlans); $('plans-overlay').addEventListener('click', closePlans);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && plansOpen) closePlans(); });

    setTimeout(showPromo, 8000);
    setInterval(() => { if (!plansModal.classList.contains('flex')) showPromo(); }, 60000);
  }

  // Workspaces logic
  const MAX_WORKSPACES = SCREEN_TIER === 'pro' ? Infinity : SCREEN_TIER === 'free' ? 2 : 0;
  function canSaveWorkspace(currentCount: number): boolean {
    if (MAX_WORKSPACES === 0) { toast.warning('Saving workspaces needs an account', { description: 'Sign up free to save up to 2 workspaces.', log: false }); return false; }
    if (currentCount >= MAX_WORKSPACES) { toast.warning(`Free plan saves up to ${MAX_WORKSPACES} workspaces`, { description: 'Upgrade to Pro for unlimited workspaces.', log: false }); return false; }
    return true;
  }

  // ---------- Persistence ----------
  type VPState = { url?: string; layout: Layout; zoom: number | 'fit'; framesOn?: boolean; devices: Device[]; customScreens?: Device[] };

  function snapshot(): VPState {
    return { url: currentUrl, layout, zoom, framesOn, devices: [...active.values()], customScreens: [...customScreens.values()] };
  }
  const store = {
    save: () => safeStore.set('vp-state', JSON.stringify(snapshot())),
    load: (): VPState | null => { try { const r = safeStore.get('vp-state'); return r ? JSON.parse(r) : null; } catch { return null; } }
  };

  const trackCustomCount = (id: string) => { if (id.startsWith('custom-')) customCount = Math.max(customCount, Number(id.split('-')[1]) || 0); };
  const saved = store.load();
  if (saved) {
    if (saved.url) currentUrl = saved.url;
    layout = saved.layout === 'grid' ? 'grid' : 'row';
    zoom = saved.zoom === 'fit' || typeof saved.zoom === 'number' ? saved.zoom : 'fit';
    framesOn = saved.framesOn !== false;
    saved.customScreens?.forEach((d) => { customScreens.set(d.id, d); trackCustomCount(d.id); });
  }

  if (saved?.devices?.length) {
    saved.devices.forEach((d) => {
      active.set(d.id, d);
      trackCustomCount(d.id);
      if (d.id.startsWith('custom-') && !customScreens.has(d.id)) customScreens.set(d.id, { ...d, rotated: false });
    });
  } else if (!saved) {
    $$<HTMLButtonElement>('.device-row[data-on="true"]').forEach((row) => { active.set(row.dataset.id!, { id: row.dataset.id!, name: row.dataset.name!, w: Number(row.dataset.w), h: Number(row.dataset.h), type: row.dataset.type!, rotated: false }); });
  }

  if (active.size > MAX_SCREENS) [...active.keys()].slice(MAX_SCREENS).forEach(id => active.delete(id));
  
  function syncDeviceRows() { $$<HTMLElement>('.device-row', sidebar).forEach(row => { row.dataset.on = String(active.has(row.dataset.id!)); }); }
  syncDeviceRows();

  // ---------- Helpers ----------
  function searchUrl(q: string) { return 'https://www.google.com/search?q=' + encodeURIComponent(q); }
  function normalizeUrl(raw: string): string | null {
    const v = raw.trim().replace(/^["']+|["']+$/g, '').trim();
    if (!v) return null;
    if (/^https?:\/\//i.test(v)) { try { return new URL(v).href; } catch { return searchUrl(v); } }
    if (/^[a-z][a-z0-9+.-]*:/i.test(v)) return searchUrl(v);
    const looksLikeHost = !/\s/.test(v) && (/\.[a-z]{2,}([:/?#]|$)/i.test(v) || /^localhost([:/?#]|$)/i.test(v) || /^\d{1,3}(\.\d{1,3}){3}([:/?#]|$)/.test(v));
    if (!looksLikeHost) return searchUrl(v);
    const isLocal = /^(localhost|127\.0\.0\.1|0\.0\.0\.0)([:/?#]|$)/i.test(v.split(/[/?#]/)[0]);
    try { return new URL((isLocal ? 'http://' : 'https://') + v).href; } catch { return searchUrl(v); }
  }

  const scaleFor = (w: number) => zoom === 'fit' ? (w <= 500 ? 0.72 : w <= 1100 ? 0.48 : 0.36) : zoom;
  const escapeHtml = (s: string) => s.replace(/[&<>"']/g, c => `&#${c.charCodeAt(0)};`);
  function titleCase(s: string) { return s.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim().replace(/\b\w/g, c => c.toUpperCase()); }
  function websiteName(u: string) { try { const p = new URL(u).hostname.replace(/^www\./i, '').split('.'); return titleCase(p.length > 2 ? p[p.length - 2] : p[0] || u); } catch { return 'Website'; } }
  function pageNameFromUrl(u: string) { try { const l = new URL(u).pathname.split('/').filter(Boolean).pop(); return l ? titleCase(decodeURIComponent(l)) : 'Home'; } catch { return 'Page'; } }
  function formatCaptureTitle() {
    const url = latestPageMeta?.url || currentUrl;
    const site = websiteName(url), page = latestPageMeta?.pageName || pageNameFromUrl(url);
    return page && page.toLowerCase() !== site.toLowerCase() ? `${site} - ${page}` : site;
  }
  function toProxy(raw: string, bust?: number) {
    try {
      const u = new URL(raw), params = new URLSearchParams(u.search);
      params.set('__vphost', u.origin);
      if (bust) params.set('__cb', String(bust));
      return `${u.pathname}?${params.toString()}${u.hash}`;
    } catch { return raw; }
  }

  function visitedUrlFromFrame(iframe: HTMLIFrameElement) {
    try {
      const loc = iframe.contentWindow?.location; 
      if (!loc || loc.href === 'about:blank') return currentUrl;
      // If it navigated inside our proxy domain, construct real URL
      if (loc.origin === window.location.origin) {
        const params = new URLSearchParams(loc.search);
        const origin = params.get('__vphost'); 
        if (!origin) return loc.href;
        params.delete('__vphost'); params.delete('__cb');
        const qs = params.toString();
        return `${origin}${loc.pathname}${qs ? `?${qs}` : ''}${loc.hash}`;
      }
      return loc.href;
    } catch { return currentUrl; }
  }

  function updatePageMetaFromFrame(iframe: HTMLIFrameElement) {
    const url = visitedUrlFromFrame(iframe), site = websiteName(url);
    let pageName = pageNameFromUrl(url);
    try {
      const t = (iframe.contentDocument?.title || '').replace(/\s+/g, ' ').trim();
      const parts = t.split(/\s[-|•:]\s/).map(p => p.trim()).filter(Boolean);
      pageName = parts.find(p => p.toLowerCase() !== site.toLowerCase()) || t || pageName;
    } catch {}
    latestPageMeta = { url, title: `${site} - ${pageName}`, pageName, updatedAt: Date.now() };
  }

  // ---------- Sync Hub (Message Listener) ----------
  // Listens for navigation events emitted by any iframe and updates the entire viewport
  window.addEventListener('message', (e) => {
    if (e.data && e.data.type === 'VP_NAVIGATE') {
      const { url: newUrl, sourceFrameId, isHardNav } = e.data;
      if (!newUrl || newUrl === currentUrl) return;

      currentUrl = newUrl;
      input.value = newUrl;
      latestPageMeta = null;
      clearBtn.style.display = 'block';
      store.save();

      if (isHardNav) {
        // Hard navigation (like external auth link) - re-proxy everything safely
        renderAll();
      } else {
        // SPA navigation - update other panes without destroying the source iframe's state
        const allPanes = $$<HTMLElement>('[data-frame-id]', frames);
        allPanes.forEach(pane => {
          if (pane.dataset.frameId === sourceFrameId) {
            const chromeUrl = pane.querySelector('[data-role="chrome-url"]');
            if (chromeUrl) chromeUrl.textContent = newUrl.replace(/^https?:\/\//, '');
          } else {
            const loader = pane.querySelector<HTMLElement>('[data-role="loader"]');
            const iframe = pane.querySelector('iframe');
            if (loader && iframe) {
              loader.style.display = 'grid';
              iframe.src = toProxy(newUrl);
            }
          }
        });
      }
    }
  });

  // ---------- Robust Iframe URL Spoofing & Routing Fix ----------
  function setupIframeLinkSpoofing(iframe: HTMLIFrameElement, frameId: string) {
    try {
      const doc = iframe.contentDocument;
      const win = iframe.contentWindow;
      if (!doc || !win) return;

      const frameUrl = new URL(win.location.href);
      const upstreamOrigin = frameUrl.searchParams.get('__vphost');
      if (!upstreamOrigin) return;

      const toRealUrl = (href: string) => {
        try {
          const u = new URL(href, win.location.href);
          if (u.origin === window.location.origin) {
            const host = u.searchParams.get('__vphost') || upstreamOrigin;
            u.searchParams.delete('__vphost');
            u.searchParams.delete('__cb');
            return new URL(u.pathname + u.search + u.hash, host).href;
          }
          return href;
        } catch { return href; }
      };

      const toProxyUrl = (href: string) => {
        try {
          const u = new URL(href, win.location.href);
          if (u.origin === window.location.origin) {
            if (!u.searchParams.get('__vphost')) u.searchParams.set('__vphost', upstreamOrigin);
            return u.href;
          }
          // Force ANY cross-origin link through the proxy and update the upstream host context
          const p = new URL(u.pathname + u.search + u.hash, window.location.origin);
          p.searchParams.set('__vphost', u.origin);
          return p.href;
        } catch { return href; }
      };

      const notifyParent = (url: string, isHardNav: boolean) => {
        try { win.parent.postMessage({ type: 'VP_NAVIGATE', url, sourceFrameId: frameId, isHardNav }, '*'); } catch {}
      };

      // 1. PATCH HISTORY API (Intercept SPA internal routing)
      try {
        const origPush = win.history.pushState;
        win.history.pushState = function(state, unused, url) {
          let realTarget = '';
          if (url) {
            try {
              realTarget = toRealUrl(new URL(url, win.location.href).href);
              url = toProxyUrl(url as string);
            } catch {}
          }
          const res = origPush.call(this, state, unused, url);
          if (realTarget) notifyParent(realTarget, false);
          return res;
        };

        const origReplace = win.history.replaceState;
        win.history.replaceState = function(state, unused, url) {
          let realTarget = '';
          if (url) {
            try {
              realTarget = toRealUrl(new URL(url, win.location.href).href);
              url = toProxyUrl(url as string);
            } catch {}
          }
          const res = origReplace.call(this, state, unused, url);
          if (realTarget) notifyParent(realTarget, false);
          return res;
        };
      } catch {}

      // 2. PATCH FETCH & XHR (Keep API requests routed through proxy if needed)
      try {
        const origFetch = win.fetch;
        win.fetch = function(input, init) {
          try {
            let urlStr = typeof input === 'string' ? input : input instanceof Request ? input.url : input instanceof URL ? input.href : '';
            if (urlStr) {
              const proxied = toProxyUrl(urlStr);
              if (typeof input === 'string') input = proxied;
              else if (input instanceof URL) input = new URL(proxied);
              else if (input instanceof Request) input = new Request(proxied, input);
            }
          } catch {}
          return origFetch.call(this, input, init);
        };

        const origOpen = win.XMLHttpRequest.prototype.open;
        win.XMLHttpRequest.prototype.open = function(method, url, ...args) {
          try { url = toProxyUrl(url as string); } catch {}
          return origOpen.call(this, method, url, ...args);
        };
      } catch {}

      // 3. HOVER SPOOFING (Make status bar show the real target URL on hover)
      const hover = (e: Event) => {
        const a = (e.target as HTMLElement).closest('a');
        if (!a) return;
        const raw = a.getAttribute('href');
        if (!raw || raw.match(/^(javascript:|mailto:|tel:|#)/i)) return;
        
        if (!a.dataset.vpProxy) {
          a.dataset.vpProxy = toProxyUrl(a.href);
          a.href = a.dataset.vpProxy;
        }
        
        a.dataset.vpSpoof = "1";
        a.href = toRealUrl(a.dataset.vpProxy);
      };

      const unhover = (e: Event) => {
        const a = (e.target as HTMLElement).closest('a');
        if (a && a.dataset.vpSpoof && a.dataset.vpProxy) {
          a.href = a.dataset.vpProxy;
          delete a.dataset.vpSpoof;
        }
      };

      doc.addEventListener('mouseover', hover, true);
      doc.addEventListener('focus', hover, true);
      doc.addEventListener('mouseout', unhover, true);
      doc.addEventListener('blur', unhover, true);
      doc.addEventListener('mousedown', unhover, true);
      doc.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') unhover(e); }, true);

      // 4. HARD NAV INTERCEPTOR 
      // Prevents IFRAME "Refused to Connect" errors by forcing clicks into proxy
      doc.addEventListener('click', (e) => {
        if (e.defaultPrevented) return; // SPAs will prevent default and use history.pushState
        
        const a = (e.target as HTMLElement).closest('a');
        if (!a || !a.href) return;
        
        if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        
        const raw = a.getAttribute('href');
        if (!raw || raw.startsWith('#') || raw.match(/^(javascript:|mailto:|tel:)/i)) return;
        if (a.target === '_blank') return; 

        e.preventDefault(); // Stop natural iframe navigation which triggers X-Frame-Options
        
        let targetUrl = a.href;
        if (a.dataset.vpProxy && a.dataset.vpSpoof) {
            targetUrl = a.href; 
        } else {
            targetUrl = toRealUrl(a.href);
        }

        notifyParent(targetUrl, true);
      }, false);

