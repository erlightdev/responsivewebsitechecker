---
import CaptureEditor from './CaptureEditor.astro';
import { getPublicPricing } from '../lib/payments/plan-store';
import { isProUser } from '../lib/payments/subscription';

// Pricing for the guest upgrade promo (sourced from synced plans).
const pricing = await getPublicPricing();
const promoMonthly = pricing.monthly?.amount ?? '$3';
const promoYearly = pricing.yearly?.amount ?? '';
const promoSavings = pricing.yearlySavingsPct;

// Device catalog, grouped Polypane-style. Panes are rendered client-side.
const groups = [
  {
    label: 'Phones',
    type: 'phone',
    icon: 'M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3',
    devices: [
      { id: 'iphone-se', name: 'iPhone SE', w: 375, h: 667, on: true },
      { id: 'iphone-15', name: 'iPhone 15 Pro', w: 393, h: 852, on: true },
      { id: 'iphone-15-max', name: 'iPhone 15 Pro Max', w: 430, h: 932, on: false },
      { id: 'pixel-8', name: 'Pixel 8', w: 412, h: 915, on: false },
      { id: 'galaxy-s24', name: 'Galaxy S24', w: 360, h: 780, on: false },
    ],
  },
  {
    label: 'Tablets',
    type: 'tablet',
    icon: 'M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-15a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z',
    devices: [
      { id: 'ipad-mini', name: 'iPad Mini', w: 768, h: 1024, on: true },
      { id: 'ipad-air', name: 'iPad Air', w: 820, h: 1180, on: false },
      { id: 'ipad-pro', name: 'iPad Pro 12.9"', w: 1024, h: 1366, on: false },
    ],
  },
  {
    label: 'Laptops & Desktops',
    type: 'desktop',
    icon: 'M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25',
    devices: [
      { id: 'macbook-air', name: 'MacBook Air', w: 1280, h: 832, on: true },
      { id: 'macbook-16', name: 'MacBook Pro 16"', w: 1536, h: 960, on: false },
      { id: 'desktop', name: 'Desktop', w: 1440, h: 900, on: false },
      { id: 'desktop-hd', name: 'Desktop HD', w: 1920, h: 1080, on: false },
    ],
  },
];

const user = Astro.locals.user;
const displayName = user?.name || user?.email?.split('@')[0] || 'Account';
const email = user?.email ?? '';
const initial = (displayName.trim()[0] || 'U').toUpperCase();

// Active-screen limit: guests 3, signed-in free tier 6, Pro/superadmin unlimited.
const isSuper = user?.role === 'superadmin';
const isPro = !isSuper && user ? await isProUser(user.id) : false;
const hasPro = isSuper || isPro;
const maxScreens = hasPro ? 0 /* 0 = unlimited */ : user ? 6 : 3;
const screenTier = hasPro ? 'pro' : user ? 'free' : 'guest';

// Social preview + Capture are Pro features — unlocked for superadmin or an
// active paid Pro subscription. Everyone else sees them locked.
const canUsePro = hasPro;
---

<div class="flex h-dvh flex-col overflow-hidden" data-max-screens={String(maxScreens)} data-screen-tier={screenTier} data-can-pro={String(canUsePro)}>
  <!-- ===== Toolbar ===== -->
  <header class="z-40 flex shrink-0 items-center gap-2 border-b border-border/60 bg-background/95 px-3 py-2 backdrop-blur">
    <!-- Sidebar toggle (mobile) -->
    <button type="button" id="sidebar-toggle" class="tip grid size-9 shrink-0 place-items-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Toggle device panel" data-tip="Toggle device panel" data-tip-align="start">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
    </button>

    <a href="/checker" class="flex shrink-0 items-center gap-2 pr-1 font-semibold tracking-tight">
      <span class="grid size-8 place-items-center rounded-md bg-primary text-primary-foreground">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      </span>
      <span class="hidden md:inline">Viewport</span>
    </a>

    <!-- URL form -->
    <form id="url-form" class="flex min-w-0 flex-1 items-center gap-2">
      <div class="flex h-9 min-w-0 flex-1 items-center gap-2 rounded-md border border-border bg-card px-3 transition-shadow focus-within:ring-2 focus-within:ring-ring/50">
        <svg class="size-4 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <input
          id="url-input"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          placeholder="Enter a URL or search — e.g. example.com"
          class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        />
        <button type="button" id="clear-btn" class="tip hidden shrink-0 rounded-full p-1 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Clear URL" data-tip="Clear URL">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <button type="submit" class="h-9 shrink-0 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-transform hover:scale-[1.03]">
        <span class="hidden sm:inline">Check</span>
        <svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>

    <!-- Clear cache -->
    <button type="button" id="clear-cache" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-rose-500/40 bg-rose-500/5 text-rose-500 transition-colors hover:bg-rose-500/15 hover:text-rose-600 dark:text-rose-400 dark:hover:text-rose-300" aria-label="Clear cache and soft-reload all devices" data-tip="Clear cache & reload">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 5v6c0 1.66-4 3-9 3s-9-1.34-9-3V5"/><path d="M21 11v6c0 1.66-4 3-9 3s-9-1.34-9-3v-6"/></svg>
    </button>

    <div class="mx-1 hidden h-6 w-px shrink-0 bg-border sm:block"></div>

    <!-- Add screen -->
    <button type="button" id="add-screen" class="tip flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-label="Add custom screen" data-tip="Add custom screen">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      <span class="hidden md:inline">Add Screen</span>
    </button>

    <!-- Workspaces -->
    <div class="relative shrink-0">
      <button type="button" id="workspace-btn" class="tip flex h-9 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-haspopup="menu" aria-expanded="false" aria-label="Workspaces" data-tip="Workspaces">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5-9 4.5-9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/></svg>
        <span class="hidden md:inline">Workspaces</span>
      </button>

      <div id="workspace-menu" class="absolute left-0 top-full z-50 mt-2 hidden w-64 origin-top-left rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md" role="menu" aria-labelledby="workspace-btn">
        <button type="button" id="ws-save" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm font-medium text-primary outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
          Save current workspace…
        </button>
        <a href="/workspaces" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          View all workspaces
        </a>
        <div class="-mx-1 my-1 h-px bg-border"></div>
        <p class="px-2 pb-1 pt-0.5 text-xs font-medium text-muted-foreground">Saved workspaces</p>
        <ul id="ws-list" class="max-h-64 overflow-auto"></ul>
        <p id="ws-empty" class="px-2 py-2 text-xs text-muted-foreground">No saved workspaces yet.</p>

        <div class="-mx-1 my-1 h-px bg-border"></div>
        <button type="button" id="ws-export" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
          Export workspaces (JSON)
        </button>
        <button type="button" id="ws-import" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 9l5-5 5 5"/><path d="M12 4v12"/></svg>
          Import workspaces…
        </button>
        <input id="ws-file" type="file" accept="application/json,.json" class="hidden" />
        <p id="ws-status" class="hidden px-2 pt-1 text-xs"></p>
      </div>
    </div>

    <!-- Social preview (Pro) -->
    <a href="/social" id="social-btn" class="tip flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-label="Social preview" data-tip={canUsePro ? 'Social preview' : 'Social preview — Pro'}>
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/></svg>
      <span class="hidden md:inline">Social</span>
      {!canUsePro && <svg class="size-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
    </a>

    <!-- Capture (Pro) -->
    <div class="relative shrink-0">
      <button type="button" id="capture-btn" class="tip flex h-9 items-center gap-1.5 rounded-md border border-border bg-card px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted sm:px-3" aria-haspopup="menu" aria-expanded="false" aria-label="Capture" data-tip={canUsePro ? 'Screenshot & record' : 'Capture — Pro'}>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
        <span class="hidden md:inline">Capture</span>
        {!canUsePro && <svg class="size-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
      </button>

      <div id="capture-menu" class="absolute left-0 top-full z-50 mt-2 hidden w-60 origin-top-left rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md" role="menu" aria-labelledby="capture-btn">
        <button type="button" id="cap-shot" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          Screenshot
        </button>
        <button type="button" id="cap-rec5" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
          Record 5s
        </button>
        <button type="button" id="cap-rec10" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
          Record 10s
        </button>
        <div class="-mx-1 my-1 h-px bg-border"></div>
        <a href="/captures" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5L9 20"/></svg>
          View captures
        </a>
        <button type="button" id="cap-stop" role="menuitem" class="menu-item hidden w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm text-muted-foreground outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
          Stop screen sharing
        </button>
        <p id="cap-status" class="hidden px-2 pt-1 text-xs"></p>
      </div>
    </div>

    <!-- Layout toggle -->
    <div class="hidden shrink-0 items-center rounded-md border border-border bg-card p-0.5 sm:flex" role="group" aria-label="Canvas layout">
      <button type="button" data-layout="row" class="tip layout-btn grid size-8 place-items-center rounded-[5px] text-muted-foreground data-[on=true]:bg-muted data-[on=true]:text-foreground hover:text-foreground" data-tip="Horizontal strip" aria-label="Horizontal layout">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="5" height="12" rx="1"/><rect x="9.5" y="6" width="5" height="12" rx="1"/><rect x="17" y="6" width="5" height="12" rx="1"/></svg>
      </button>
      <button type="button" data-layout="grid" class="tip layout-btn grid size-8 place-items-center rounded-[5px] text-muted-foreground data-[on=true]:bg-muted data-[on=true]:text-foreground hover:text-foreground" data-tip="Grid layout" aria-label="Grid layout">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
      </button>
    </div>

    <!-- Device frame toggle -->
    <button type="button" id="frame-toggle" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground data-[on=true]:border-primary data-[on=true]:bg-primary/10 data-[on=true]:text-primary" data-on="true" aria-label="Toggle device frames" aria-pressed="true" data-tip="Toggle device frames">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M10 19h4"/></svg>
    </button>

    <!-- Zoom -->
    <div class="flex h-9 shrink-0 items-center rounded-md border border-border bg-card p-0.5">
      <button type="button" data-zoom-step="-1" class="tip grid size-8 place-items-center rounded-[5px] text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Zoom out" data-tip="Zoom out">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
      </button>
      <button type="button" id="zoom-label" class="tip w-12 rounded-[5px] py-1.5 text-center text-xs font-semibold tabular-nums hover:bg-muted" data-tip="Reset to fit">Fit</button>
      <button type="button" data-zoom-step="1" class="tip grid size-8 place-items-center rounded-[5px] text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Zoom in" data-tip="Zoom in">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>

    <!-- Rotate / reload all -->
    <button type="button" id="rotate-all" class="tip grid size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Rotate all devices" data-tip="Rotate all">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
    </button>
    <button type="button" id="reload-all" class="tip hidden size-9 shrink-0 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:grid" aria-label="Reload all devices" data-tip="Reload all">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
    </button>

    <!-- Theme menu -->
    <div class="relative shrink-0">
      <button
        type="button"
        id="theme-btn"
        class="tip grid size-9 place-items-center rounded-md border border-border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Open theme menu"
        aria-haspopup="menu"
        aria-expanded="false"
        data-tip="Theme"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.012 17.5 2 12 2z"/></svg>
      </button>

      <!-- Theme dropdown -->
      <div
        id="theme-menu"
        class="absolute right-0 top-full z-50 mt-2 hidden w-56 origin-top-right rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
        role="menu"
        aria-labelledby="theme-btn"
      >
        <p class="px-2 pb-1 pt-1.5 text-xs font-medium text-muted-foreground">Theme</p>
        <div class="grid grid-cols-3 gap-1 px-1">
          <button type="button" data-theme-mode="light" role="menuitemradio" aria-checked="false" class="theme-mode flex flex-col items-center gap-1 rounded-sm border border-transparent px-1 py-2 text-xs outline-none hover:bg-accent hover:text-accent-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            Light
          </button>
          <button type="button" data-theme-mode="dark" role="menuitemradio" aria-checked="false" class="theme-mode flex flex-col items-center gap-1 rounded-sm border border-transparent px-1 py-2 text-xs outline-none hover:bg-accent hover:text-accent-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            Dark
          </button>
          <button type="button" data-theme-mode="system" role="menuitemradio" aria-checked="false" class="theme-mode flex flex-col items-center gap-1 rounded-sm border border-transparent px-1 py-2 text-xs outline-none hover:bg-accent hover:text-accent-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            System
          </button>
        </div>

        <div class="-mx-1 my-1 h-px bg-border"></div>
        <p class="px-2 pb-1 pt-0.5 text-xs font-medium text-muted-foreground">Color</p>
        <div class="grid grid-cols-6 gap-1 px-2 pb-1.5 pt-0.5">
          <button type="button" data-color="emerald" aria-checked="false" aria-label="Emerald" class="color-swatch mx-auto size-5 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-popover transition-shadow aria-checked:ring-foreground" style="background:oklch(0.7116 0.1798 153.9)"></button>
          <button type="button" data-color="blue" aria-checked="false" aria-label="Blue" class="color-swatch mx-auto size-5 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-popover transition-shadow aria-checked:ring-foreground" style="background:oklch(0.58 0.19 256)"></button>
          <button type="button" data-color="violet" aria-checked="false" aria-label="Violet" class="color-swatch mx-auto size-5 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-popover transition-shadow aria-checked:ring-foreground" style="background:oklch(0.55 0.22 293)"></button>
          <button type="button" data-color="rose" aria-checked="false" aria-label="Rose" class="color-swatch mx-auto size-5 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-popover transition-shadow aria-checked:ring-foreground" style="background:oklch(0.62 0.22 14)"></button>
          <button type="button" data-color="amber" aria-checked="false" aria-label="Amber" class="color-swatch mx-auto size-5 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-popover transition-shadow aria-checked:ring-foreground" style="background:oklch(0.77 0.16 70)"></button>
          <button type="button" data-color="black" aria-checked="false" aria-label="Black" class="color-swatch mx-auto size-5 rounded-full border border-border ring-2 ring-transparent ring-offset-2 ring-offset-popover transition-shadow aria-checked:ring-foreground" style="background:oklch(0.2 0 0)"></button>
        </div>
      </div>
    </div>

    <!-- Guest CTA -->
    {!user && (
      <div class="flex shrink-0 items-center gap-2">
        <a href="/login" class="hidden h-9 items-center rounded-md px-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline-flex">Log in</a>
        <a href="/signup" class="inline-flex h-9 items-center rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.03]">Sign up free</a>
      </div>
    )}

    <!-- Account menu -->
    <div class:list={['relative shrink-0', !user && 'hidden']}>
      <button
        type="button"
        id="account-btn"
        class="grid size-9 place-items-center rounded-full border border-border bg-primary/10 text-sm font-semibold text-primary transition-colors hover:bg-primary/20 focus-visible:ring-2 focus-visible:ring-ring/50"
        aria-label="Open account menu"
        aria-haspopup="menu"
        aria-expanded="false"
      >
        {initial}
      </button>

      <!-- Dropdown (shadcn-style) -->
      <div
        id="account-menu"
        class="absolute right-0 top-full z-50 mt-2 hidden w-60 origin-top-right rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
        role="menu"
        aria-labelledby="account-btn"
      >
        <!-- User label -->
        <div class="flex items-center gap-2 px-2 py-1.5">
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-semibold text-primary">{initial}</span>
          <div class="min-w-0">
            <p class="truncate text-sm font-medium leading-tight">{displayName}</p>
            <p class="truncate text-xs text-muted-foreground">{email}</p>
          </div>
        </div>
        <div class="-mx-1 my-1 h-px bg-border"></div>

        <!-- Upgrade CTA (hidden once the user is on Pro) -->
        {!hasPro && (
          <a href="/billing" role="menuitem" class="menu-item flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm font-medium text-primary outline-none hover:bg-accent hover:text-accent-foreground">
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg>
            Upgrade to Pro
          </a>
        )}
        <div class="-mx-1 my-1 h-px bg-border"></div>

        <!-- Account group -->
        <a href="/account" role="menuitem" class="menu-item flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Account
        </a>
        <a href="/billing" role="menuitem" class="menu-item flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          Billing
        </a>
        <a href="/settings" role="menuitem" class="menu-item flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          Settings
        </a>
        <button type="button" id="shortcuts-item" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"/></svg>
          Keyboard shortcuts
          <span class="ml-auto text-xs tracking-widest text-muted-foreground">?</span>
        </button>
        <div class="-mx-1 my-1 h-px bg-border"></div>

        <!-- Help + logout -->
        <a href="/help" role="menuitem" class="menu-item flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
          Help &amp; Support
        </a>
        <button type="button" id="logout-item" role="menuitem" class="menu-item flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-sm text-destructive outline-none hover:bg-destructive/10">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          Log out
        </button>
      </div>
    </div>
  </header>

  <!-- Logout overlay -->
  <div id="logout-overlay" class="fixed inset-0 z-100 hidden flex-col items-center justify-center gap-3 bg-background/80 backdrop-blur-sm">
    <svg class="size-8 animate-spin text-primary" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z"/></svg>
    <p class="text-sm font-medium text-muted-foreground">Signing out…</p>
  </div>

  <div class="relative flex min-h-0 flex-1 overflow-hidden">
    <!-- ===== Sidebar ===== -->
    <aside
      id="sidebar"
      class="absolute inset-y-0 left-0 z-30 flex w-72 -translate-x-full flex-col border-r border-border/60 bg-background transition-[transform,margin] duration-300 ease-in-out data-[open=true]:translate-x-0 lg:static lg:translate-x-0 data-[collapsed=true]:lg:-ml-72 data-[collapsed=true]:lg:-translate-x-full"
      data-open="false"
      data-collapsed="false"
    >
      <div class="flex items-center justify-between px-4 pb-2 pt-4">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Devices</h2>
        <span id="device-count" class="rounded-full bg-primary/15 px-2 py-0.5 text-xs font-semibold tabular-nums text-primary">0</span>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-4 [scrollbar-width:thin]">
        {groups.map((g) => (
          <div class="mt-3 first:mt-1">
            <p class="flex items-center gap-2 px-2 pb-1.5 text-xs font-medium text-muted-foreground">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={g.icon}/></svg>
              {g.label}
            </p>
            <ul>
              {g.devices.map((d) => (
                <li>
                  <button
                    type="button"
                    class="device-row group flex w-full items-center gap-2.5 rounded-md px-2 py-2 text-left text-sm transition-colors hover:bg-muted"
                    data-id={d.id}
                    data-name={d.name}
                    data-w={d.w}
                    data-h={d.h}
                    data-type={g.type}
                    data-on={String(d.on)}
                  >
                    <span class="grid size-4 shrink-0 place-items-center rounded border border-border transition-colors group-data-[on=true]:border-primary group-data-[on=true]:bg-primary">
                      <svg class="size-3 text-primary-foreground opacity-0 transition-opacity group-data-[on=true]:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    </span>
                    <span class="min-w-0 flex-1 truncate">{d.name}</span>
                    <span class="shrink-0 text-xs tabular-nums text-muted-foreground">{d.w}×{d.h}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <!-- Custom screens (populated dynamically) -->
        <div id="custom-group" class="mt-3 hidden">
          <p class="flex items-center gap-2 px-2 pb-1.5 text-xs font-medium text-muted-foreground">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8M8 12h8"/></svg>
            Custom
          </p>
          <ul id="custom-list"></ul>
        </div>
      </div>

      <p class="border-t border-border/60 p-4 text-xs leading-relaxed text-muted-foreground">
        Sites that send <code class="rounded bg-muted px-1 py-0.5 text-[11px]">X-Frame-Options</code> headers can't be embedded and will show a notice.
      </p>
    </aside>
    <div id="sidebar-backdrop" class="absolute inset-0 z-20 hidden bg-background/60 backdrop-blur-sm lg:hidden"></div>

    <!-- ===== Canvas ===== -->
    <div
      id="canvas"
      class="min-w-0 flex-1 overflow-auto bg-[radial-gradient(circle,_var(--border)_1px,_transparent_1px)] [background-size:22px_22px]"
    >
      <!-- Empty state -->
      <div id="empty-state" class="flex h-full flex-col items-center justify-center px-6 text-center">
        <div class="grid size-16 place-items-center rounded-md bg-primary/10 text-primary">
          <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25"/></svg>
        </div>
        <h1 class="mt-6 text-2xl font-bold tracking-tight">Test any website on every screen</h1>
        <p class="mt-2 max-w-md text-sm text-muted-foreground">
          Enter a URL above and hit <span class="font-semibold text-foreground">Check</span>. Pick devices from the panel on the left.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm">
          <span class="text-muted-foreground">Try:</span>
          {['example.com', 'astro.build', 'tailwindcss.com'].map((s) => (
            <button type="button" class="sample-url rounded-full border border-border bg-card px-3 py-1 text-sm transition-colors hover:border-primary hover:text-primary" data-url={s}>{s}</button>
          ))}
        </div>
      </div>

      <!-- Panes render here -->
      <div id="frames" class="hidden"></div>
    </div>
  </div>

  <!-- ===== Add Screen modal ===== -->
  <div id="screen-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="screen-modal-title">
    <div id="screen-modal-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-sm rounded-lg border border-border bg-background p-6 shadow-xl">
      <button type="button" id="screen-modal-close" class="absolute right-4 top-4 grid size-7 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Close">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h2 id="screen-modal-title" class="text-lg font-semibold tracking-tight">Add custom screen</h2>
      <p class="mt-1 text-sm text-muted-foreground">Name it and set a viewport size — it'll be added to the sidebar.</p>
      <form id="screen-form" class="mt-5 space-y-4">
        <div class="space-y-1.5">
          <label for="screen-name" class="text-sm font-medium">Name</label>
          <input id="screen-name" type="text" placeholder="e.g. My Laptop" autocomplete="off" spellcheck="false" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm outline-none focus:ring-2 focus:ring-ring/50" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-1.5">
            <label for="screen-w" class="text-sm font-medium">Width</label>
            <input id="screen-w" type="number" min="200" max="3840" placeholder="1280" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm tabular-nums outline-none focus:ring-2 focus:ring-ring/50" />
          </div>
          <div class="space-y-1.5">
            <label for="screen-h" class="text-sm font-medium">Height</label>
            <input id="screen-h" type="number" min="200" max="3840" placeholder="800" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm tabular-nums outline-none focus:ring-2 focus:ring-ring/50" />
          </div>
        </div>
        <p id="screen-error" class="hidden text-xs font-medium text-destructive">Enter a width and height between 200 and 3840.</p>
        <div class="mt-2 flex justify-end gap-2">
          <button type="button" id="screen-cancel" class="h-9 rounded-md border border-border bg-card px-4 text-sm font-medium transition-colors hover:bg-muted">Cancel</button>
          <button type="submit" class="h-9 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.03]">Add Screen</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== Delete confirmation modal ===== -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="alertdialog" aria-modal="true" aria-labelledby="delete-modal-title">
    <div id="delete-modal-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-sm rounded-lg border border-border bg-background p-6 shadow-xl">
      <h2 id="delete-modal-title" class="text-lg font-semibold tracking-tight">Delete screen?</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        <span id="delete-modal-name" class="font-medium text-foreground"></span> will be removed from the sidebar and canvas. This can't be undone.
      </p>
      <div class="mt-6 flex justify-end gap-2">
        <button type="button" id="delete-cancel" class="h-9 rounded-md border border-border bg-card px-4 text-sm font-medium transition-colors hover:bg-muted">Cancel</button>
        <button type="button" id="delete-confirm" class="h-9 rounded-md bg-destructive px-4 text-sm font-semibold text-white transition-transform hover:scale-[1.03]">Delete</button>
      </div>
    </div>
  </div>

  <!-- ===== Save workspace modal ===== -->
  <div id="workspace-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="workspace-modal-title">
    <div id="workspace-modal-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-sm rounded-lg border border-border bg-background p-6 shadow-xl">
      <button type="button" id="workspace-modal-close" class="absolute right-4 top-4 grid size-7 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Close">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h2 id="workspace-modal-title" class="text-lg font-semibold tracking-tight">Save workspace</h2>
      <p class="mt-1 text-sm text-muted-foreground">Save the current URL, devices, layout, zoom and order under a name.</p>
      <form id="workspace-form" class="mt-5 space-y-4">
        <div class="space-y-1.5">
          <label for="workspace-name" class="text-sm font-medium">Name</label>
          <input id="workspace-name" type="text" placeholder="e.g. Marketing site — mobile" autocomplete="off" spellcheck="false" class="h-9 w-full rounded-md border border-border bg-card px-3 text-sm outline-none focus:ring-2 focus:ring-ring/50" />
        </div>
        <p id="workspace-error" class="hidden text-xs font-medium text-destructive">Enter a name for the workspace.</p>
        <div class="mt-2 flex justify-end gap-2">
          <button type="button" id="workspace-cancel" class="h-9 rounded-md border border-border bg-card px-4 text-sm font-medium transition-colors hover:bg-muted">Cancel</button>
          <button type="submit" class="h-9 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.03]">Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== Keyboard shortcuts modal ===== -->
  <div id="shortcuts-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title">
    <div id="shortcuts-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative z-10 w-full max-w-md rounded-lg border border-border bg-background p-6 shadow-xl">
      <button type="button" id="shortcuts-close" class="absolute right-4 top-4 grid size-7 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground" aria-label="Close">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <h2 id="shortcuts-title" class="text-lg font-semibold tracking-tight">Keyboard shortcuts</h2>
      <p class="mt-1 text-sm text-muted-foreground">Speed up common actions.</p>
      <ul class="mt-5 space-y-2.5 text-sm">
        <li class="flex items-center justify-between gap-4">
          <span>Focus URL bar</span>
