  type Workspace = { id: string; name: string; state: VPState };
  const WS_KEY = 'vp-workspaces', ACTIVE_WS_KEY = 'vp-active-ws';
  const wsList = $('ws-list'), wsEmpty = $('ws-empty');

  const loadWorkspaces = (): Workspace[] => { try { return JSON.parse(safeStore.get(WS_KEY) || '[]'); } catch { return []; } };
  const saveWorkspaces = (list: Workspace[]) => safeStore.set(WS_KEY, JSON.stringify(list));
  const activeWsId = () => safeStore.get(ACTIVE_WS_KEY) || '';

  function applyState(s: VPState) {
    currentUrl = s.url || ''; input.value = currentUrl; clearBtn.style.display = currentUrl ? 'block' : 'none';
    layout = s.layout === 'grid' ? 'grid' : 'row'; zoom = s.zoom === 'fit' || typeof s.zoom === 'number' ? s.zoom : 'fit'; framesOn = s.framesOn !== false;
    active.clear();
    (s.devices || []).forEach(d => active.set(d.id, d));
    if (active.size > MAX_SCREENS) [...active.keys()].slice(MAX_SCREENS).forEach(id => active.delete(id));

    customScreens.clear(); customList.innerHTML = '';
    (s.customScreens || []).forEach(d => { customScreens.set(d.id, d); trackCustomCount(d.id); insertCustomRow(d); });
    syncCustomGroup(); syncDeviceRows(); applyLayout(); syncFrameToggle();
    zoomLabel.textContent = zoom === 'fit' ? 'Fit' : `${Math.round((zoom as number) * 100)}%`;
    updateCount();
    if (currentUrl) renderAll(); else { clearFrames(); emptyState.style.display = 'flex'; }
    store.save();
  }

  function renderWorkspaces() {
    const list = loadWorkspaces(), activeId = activeWsId();
    wsList.innerHTML = ''; wsEmpty.style.display = list.length ? 'none' : 'block';
    const frag = document.createDocumentFragment();
    list.forEach(ws => {
      const li = document.createElement('li'), isActive = ws.id === activeId;
      li.innerHTML = `<div class="group flex items-center gap-1 rounded-sm px-1 hover:bg-accent"><button type="button" class="ws-load flex min-w-0 flex-1 items-center gap-2 py-1.5 pl-1 text-left text-sm outline-none" data-id="${ws.id}"><svg class="size-3.5 shrink-0 ${isActive ? 'text-primary' : 'text-muted-foreground'}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5-9 4.5-9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/></svg><span class="min-w-0 flex-1 truncate ${isActive ? 'font-medium' : ''}">${escapeHtml(ws.name)}</span>${isActive ? '<span class="shrink-0 text-[10px] font-semibold uppercase tracking-wide text-primary">Active</span>' : ''}</button><button type="button" class="ws-del grid size-6 shrink-0 place-items-center rounded text-muted-foreground opacity-0 transition-opacity hover:text-destructive focus-visible:opacity-100 group-hover:opacity-100" data-id="${ws.id}" aria-label="Delete" title="Delete workspace"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button></div>`;
      li.querySelector('.ws-load')!.addEventListener('click', () => {
        const found = loadWorkspaces().find(w => w.id === ws.id); if (!found) return;
        applyState(found.state); safeStore.set(ACTIVE_WS_KEY, ws.id); renderWorkspaces(); closeAllMenus();
        toast.info('Workspace loaded', { description: ws.name, log: 'Workspace loaded' });
      });
      li.querySelector('.ws-del')!.addEventListener('click', (e) => {
        e.stopPropagation(); saveWorkspaces(loadWorkspaces().filter(w => w.id !== ws.id));
        if (activeWsId() === ws.id) safeStore.remove(ACTIVE_WS_KEY); renderWorkspaces();
        toast.success('Workspace deleted', { description: ws.name, log: 'Workspace deleted' });
      });
      frag.appendChild(li);
    });
    wsList.appendChild(frag);
  }

  const wsModal = $('workspace-modal'), wsNameEl = $<HTMLInputElement>('workspace-name'), wsErr = $('workspace-error');
  function openWsModal() { wsNameEl.value = ''; wsErr.style.display = 'none'; wsModal.style.display = 'flex'; setTimeout(() => wsNameEl.focus(), 0); }
  const closeWsModal = () => { wsModal.style.display = 'none'; };

  $('ws-save').addEventListener('click', () => { closeAllMenus(); if (!canSaveWorkspace(loadWorkspaces().length)) return; openWsModal(); });
  $('workspace-cancel').addEventListener('click', closeWsModal); $('workspace-modal-close').addEventListener('click', closeWsModal); $('workspace-modal-overlay').addEventListener('click', closeWsModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && wsModal.style.display === 'flex') closeWsModal(); });
  ($('workspace-form') as HTMLFormElement).addEventListener('submit', (e) => {
    e.preventDefault(); const name = wsNameEl.value.trim(); if (!name) { wsErr.style.display = 'block'; return; }
    const list = loadWorkspaces(); if (!canSaveWorkspace(list.length)) return closeWsModal();
    const id = `ws-${Date.now()}`; list.push({ id, name, state: snapshot() });
    saveWorkspaces(list); safeStore.set(ACTIVE_WS_KEY, id); renderWorkspaces(); closeWsModal();
    toast.success('Workspace saved', { description: name, log: 'Workspace saved' });
  });
  renderWorkspaces();

  // Export / Import
  let wsStatusTimer = 0;
  function showWsStatus(msg: string, isError: boolean) {
    const el = $('ws-status'); el.textContent = msg; el.style.display = 'block'; el.className = `px-2 pt-1 text-xs ${isError ? 'text-destructive' : 'text-muted-foreground'}`;
    clearTimeout(wsStatusTimer); wsStatusTimer = window.setTimeout(() => { el.style.display = 'none'; }, 4000);
  }
  function downloadJSON(filename: string, text: string) {
    const url = URL.createObjectURL(new Blob([text], { type: 'application/json' })), a = document.createElement('a');
    a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
  }
  $('ws-export').addEventListener('click', () => {
    let list = loadWorkspaces(); if (!list.length) list = [{ id: `ws-${Date.now()}`, name: 'Current', state: snapshot() }];
    const payload = { app: 'viewport', kind: 'workspaces', version: 1, exportedAt: new Date().toISOString(), workspaces: list };
    downloadJSON(`viewport-workspaces-${new Date().toISOString().slice(0, 10)}.json`, JSON.stringify(payload, null, 2));
    const msg = `Exported ${list.length} workspace${list.length > 1 ? 's' : ''}.`; showWsStatus(msg, false); toast.success('Workspaces exported', { description: msg, log: 'Workspaces exported' });
  });

  const wsFile = $<HTMLInputElement>('ws-file');
  $('ws-import').addEventListener('click', () => wsFile.click());
  wsFile.addEventListener('change', async () => {
    const file = wsFile.files?.[0]; if (!file) return;
    try {
      const data = JSON.parse(await file.text()), incoming = Array.isArray(data) ? data : data?.workspaces;
      if (!Array.isArray(incoming)) throw new Error('no workspaces');
      const valid = incoming.filter((w: any) => w && typeof w.name === 'string' && w.state && Array.isArray(w.state.devices));
      if (!valid.length) throw new Error('no valid workspaces');
      const list = loadWorkspaces(), room = MAX_WORKSPACES - list.length;
      if (room <= 0) return toast.warning(MAX_WORKSPACES === 0 ? 'Saving workspaces needs an account' : `Free plan saves up to ${MAX_WORKSPACES} workspaces`, { description: MAX_WORKSPACES === 0 ? 'Sign up free to import workspaces.' : 'Upgrade to Pro for unlimited workspaces.', log: false });
      const toAdd = valid.slice(0, room);
      toAdd.forEach((w: Workspace, i: number) => list.push({ id: `ws-${Date.now()}-${i}`, name: w.name, state: w.state }));
      saveWorkspaces(list); renderWorkspaces();
      const skipped = valid.length - toAdd.length, msg = `Imported ${toAdd.length} workspace${toAdd.length > 1 ? 's' : ''}${skipped ? ` · ${skipped} skipped (limit reached)` : ''}.`;
      showWsStatus(msg, skipped > 0); toast.success('Workspaces imported', { description: msg, log: 'Workspaces imported' });
    } catch { showWsStatus('Import failed — not a valid workspaces file.', true); toast.error('Import failed', { description: 'Not a valid workspaces file.', log: 'Import failed' }); }
    finally { wsFile.value = ''; }
  });

  // ---------- Screen Capture ----------
  const openEditor = mountEditor();
  const canvasEl = $('canvas'), capStop = $('cap-stop'), recBadge = $('rec-badge'), recText = $('rec-text');
  const hostOf = (u: string) => { try { return new URL(u).hostname; } catch { return ''; } };

  let capStatusTimer = 0;
  function capStatus(msg: string, isError = false) {
    const el = $('cap-status'); el.textContent = msg; el.className = `px-2 pt-1 text-xs ${isError ? 'text-destructive' : 'text-muted-foreground'}`; el.style.display = 'block';
    clearTimeout(capStatusTimer); capStatusTimer = window.setTimeout(() => { el.style.display = 'none'; }, 4000);
  }
  const syncSharing = () => { capStop.style.display = isSharing() ? 'flex' : 'none'; };
  const onCaptureSaved = (c: Capture) => toast.success(c.type === 'video' ? 'Recording saved' : 'Screenshot saved', { description: c.title || c.host || 'Saved to Captures', log: c.type === 'video' ? 'Recording saved' : 'Screenshot saved' });

  function baseCapture(type: 'screenshot' | 'video', blob: Blob, thumb: Blob | null, width: number, height: number, durationMs: number): Capture {
    return { id: crypto.randomUUID(), type, blob, thumb, mime: blob.type, url: currentUrl, host: hostOf(currentUrl), title: formatCaptureTitle(), description: '', notes: '', annotations: [], durationMs, width, height, createdAt: Date.now() };
  }

  if (!isSupported()) ['cap-shot', 'cap-rec5', 'cap-rec10'].forEach(id => { const b = $<HTMLButtonElement>(id); b.disabled = true; b.classList.add('opacity-50', 'cursor-not-allowed'); });

  async function doScreenshot() {
    closeAllMenus();
    try { const { blob, width, height } = await screenshot(canvasEl); syncSharing(); openEditor(baseCapture('screenshot', blob, blob, width, height, 0), onCaptureSaved); }
    catch { capStatus('Capture cancelled or blocked.', true); toast.warning('Screenshot cancelled', { log: 'Screenshot cancelled' }); }
  }
  async function doRecord(seconds: number) {
    closeAllMenus(); recText.textContent = `Recording… ${seconds}s`; recBadge.style.display = 'flex';
    try {
      const { blob, thumb, width, height, durationMs } = await record(seconds * 1000, (rem) => { recText.textContent = `Recording… ${Math.ceil(rem / 1000)}s`; });
      recBadge.style.display = 'none'; syncSharing(); openEditor(baseCapture('video', blob, thumb, width, height, durationMs), onCaptureSaved);
    } catch { recBadge.style.display = 'none'; capStatus('Recording cancelled or blocked.', true); toast.warning('Recording cancelled', { log: 'Recording cancelled' }); }
  }

  $('cap-shot').addEventListener('click', doScreenshot);
  $('cap-rec5').addEventListener('click', () => doRecord(5));
  $('cap-rec10').addEventListener('click', () => doRecord(10));
  capStop.addEventListener('click', () => { stopSharing(); syncSharing(); closeAllMenus(); });
  syncSharing();

  // ---------- Keyboard Shortcuts Modal ----------
  $('shortcuts-item').addEventListener('click', () => { closeAccountMenu(); $('shortcuts-modal').style.display = 'flex'; });
  $('shortcuts-close').addEventListener('click', () => { $('shortcuts-modal').style.display = 'none'; });
  $('shortcuts-overlay').addEventListener('click', () => { $('shortcuts-modal').style.display = 'none'; });
  document.addEventListener('keydown', (e) => {
    const typing = /^(input|textarea)$/i.test((e.target as HTMLElement).tagName);
    if (e.key === '?' && !typing) { e.preventDefault(); $('shortcuts-modal').style.display = 'flex'; }
    if (e.key === '/' && !typing) { e.preventDefault(); input.focus(); }
    if (e.key === 'Escape' && $('shortcuts-modal').style.display === 'flex') $('shortcuts-modal').style.display = 'none';
  });

  // ---------- Auth / URL Params ----------
  let loggingOut = false;
  $('logout-item').addEventListener('click', async () => {
    if (loggingOut) return; loggingOut = true; closeAccountMenu(); $('logout-overlay').style.display = 'flex';
    try { await signOut(); } catch {}
    safeStore.clearKeys('vp-');
    setTimeout(() => { location.href = '/login'; }, 450);
  });

  {
    const sp = new URLSearchParams(location.search), authFlag = sp.get('auth');
    if (authFlag) {
      if (authFlag === 'welcome') toast.success('Welcome to Viewport', { description: 'Your account is ready.', log: false });
      else if (authFlag === 'verified') toast.success('Email verified', { description: 'You are signed in.', log: false });
      else toast.success('Signed in', { description: 'Welcome back!', log: false });
      sp.delete('auth'); const qs = sp.toString(); history.replaceState({}, '', location.pathname + (qs ? `?${qs}` : ''));
    }
    const paramUrl = sp.get('url'); if (paramUrl) { input.value = paramUrl; form.requestSubmit(); }
  }
