  $('delete-confirm').addEventListener('click', () => { if (pendingDeleteId) deleteCustomScreen(pendingDeleteId); closeDeleteModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && deleteModal.style.display === 'flex') closeDeleteModal(); });

  // Layout / Zoom / Settings
  $$<HTMLButtonElement>('.layout-btn').forEach(b => b.addEventListener('click', () => { layout = (b.dataset.layout as Layout) ?? 'row'; applyLayout(); store.save(); }));
  const ZOOMS = [0.25, 0.36, 0.5, 0.65, 0.8, 1];
