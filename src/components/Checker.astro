      : `<div class="overflow-hidden rounded-lg border border-border/70 bg-card shadow-2xl"><div class="flex items-center gap-2 border-b border-border/60 bg-muted/40 px-3 py-1.5"><span class="flex gap-1.5"><span class="size-2.5 rounded-full bg-destructive/60"></span><span class="size-2.5 rounded-full bg-chart-3/60"></span><span class="size-2.5 rounded-full bg-primary/60"></span></span><span data-role="chrome-url" class="min-w-0 flex-1 truncate rounded bg-background/70 px-2 py-0.5 text-[10px] text-muted-foreground">${currentUrl.replace(/^https?:\/\//, '')}</span></div>${screen}</div>`;

