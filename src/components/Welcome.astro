---
const devices = [
	{ name: 'Mobile', size: '390 x 844', span: 'col-span-12 sm:col-span-4' },
	{ name: 'Tablet', size: '768 x 1024', span: 'col-span-12 sm:col-span-7' },
	{ name: 'Desktop', size: '1440 x 900', span: 'col-span-12' },
];
---

<main class="relative isolate min-h-dvh overflow-hidden bg-background px-4 py-6 sm:px-6 lg:px-8">
	<div class="absolute left-[-10%] top-[-15%] -z-10 size-96 rounded-full bg-primary/20 blur-3xl"></div>
	<div class="absolute bottom-[-20%] right-[-10%] -z-10 size-96 rounded-full bg-accent/20 blur-3xl"></div>

	<section class="mx-auto grid min-h-[calc(100dvh-3rem)] w-full max-w-6xl items-center gap-10 py-10 lg:grid-cols-[1fr_0.92fr]">
		<div class="max-w-2xl">
			<p class="mb-4 inline-flex rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
				Astro + Tailwind CSS v4
			</p>

			<h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-6xl">
				Check every breakpoint before your users do.
			</h1>

			<p class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground">
				Preview a site across common device widths, catch layout issues early, and keep responsive reviews fast.
			</p>

			<form class="mt-8 flex flex-col gap-3 rounded-lg border bg-card/80 p-2 shadow-2xl shadow-primary/10 backdrop-blur sm:flex-row">
				<label class="sr-only" for="website-url">Website URL</label>
				<input
					id="website-url"
					name="url"
					type="url"
					placeholder="https://example.com"
					class="min-h-12 flex-1 rounded-md border bg-background px-4 text-base text-foreground outline-none ring-ring/60 placeholder:text-muted-foreground focus:ring-2"
				/>
				<button
					type="submit"
					class="min-h-12 rounded-md bg-primary px-6 font-semibold text-primary-foreground transition hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background"
				>
					Check site
				</button>
			</form>

			<div class="mt-8 grid gap-3 text-sm text-muted-foreground sm:grid-cols-3">
				<div class="rounded-lg border bg-card/60 p-4">
					<strong class="block text-card-foreground">3 presets</strong>
					Mobile, tablet, and desktop widths.
				</div>
				<div class="rounded-lg border bg-card/60 p-4">
					<strong class="block text-card-foreground">Fast review</strong>
					Optimized for quick visual checks.
				</div>
				<div class="rounded-lg border bg-card/60 p-4">
					<strong class="block text-card-foreground">Clean stack</strong>
					Astro powered, Tailwind styled.
				</div>
			</div>
		</div>

		<div class="rounded-lg border bg-card/80 p-4 shadow-2xl shadow-primary/10 backdrop-blur">
			<div class="mb-4 flex items-center justify-between">
				<div>
					<h2 class="font-semibold text-card-foreground">Responsive preview</h2>
					<p class="text-sm text-muted-foreground">Example viewport sizes</p>
				</div>
				<div class="flex gap-1.5">
					<span class="size-3 rounded-full bg-destructive"></span>
					<span class="size-3 rounded-full bg-chart-2"></span>
					<span class="size-3 rounded-full bg-primary"></span>
				</div>
			</div>

			<div class="grid grid-cols-12 gap-3">
				{
					devices.map((device) => (
						<article class={`${device.span} rounded-lg border bg-background p-3`}>
							<div class="mb-3 flex items-center justify-between text-xs text-muted-foreground">
								<span>{device.name}</span>
								<span>{device.size}</span>
							</div>
							<div class="space-y-2 rounded-md bg-muted p-3">
								<div class="h-2 w-1/2 rounded-full bg-primary" />
								<div class="h-2 rounded-full bg-secondary" />
								<div class="h-2 w-5/6 rounded-full bg-secondary" />
								<div class="mt-4 grid grid-cols-3 gap-2">
									<div class="h-12 rounded bg-accent" />
									<div class="h-12 rounded bg-accent" />
									<div class="h-12 rounded bg-accent" />
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</main>
