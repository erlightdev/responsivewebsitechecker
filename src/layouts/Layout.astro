---
import '../styles/global.css';

const { title = 'Responsive Website Checker' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Run before paint to avoid flash of wrong theme -->
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('vp-theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'light' || (!stored && !prefersDark)) {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body class="min-h-dvh bg-background font-sans text-foreground antialiased">
		<slot />
	</body>
</html>
