---
import '../styles/global.css';

const { title = 'Responsive Website Checker' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Run before paint to avoid flash of wrong theme -->
		<script is:inline>
			(function () {
				// 'vp-theme' ∈ 'light' | 'dark' | 'system' (or null → system)
				const stored = localStorage.getItem('vp-theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const dark = stored === 'dark' || ((stored === 'system' || !stored) && prefersDark);
				document.documentElement.classList.toggle('dark', dark);
				// color theme (accent palette)
				document.documentElement.dataset.theme = localStorage.getItem('vp-color') || 'emerald';
			})();
		</script>
	</head>
	<body class="min-h-dvh bg-background font-sans text-foreground antialiased">
		<slot />
	</body>
</html>
