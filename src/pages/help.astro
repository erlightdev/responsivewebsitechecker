---
import Layout from '../layouts/Layout.astro';
import AccountShell from '../components/AccountShell.astro';

const telegramUrl = '#';
const whatsappUrl = '#';

const faqs = [
  { q: "Why does a site show a blank frame or a notice?", a: "Some sites send X-Frame-Options or Content-Security-Policy headers that block embedding. Those can't be previewed in an iframe and will show a notice instead." },
  { q: 'How do I add a custom screen size?', a: 'Click "Add Screen" in the toolbar, enter a name plus width and height, and it appears in the sidebar under "Custom".' },
  { q: 'How do I switch themes?', a: 'Open the account menu (top-right) and choose Light, Dark, or System under Theme.' },
  { q: 'Can I rotate or reload a device?', a: 'Each preview has rotate, reload, and open-in-new-tab controls. Use the toolbar buttons to rotate or reload all at once.' },
];
---

<Layout title="Help & Support — Viewport">
  <AccountShell active="help" heading="Help & Support" description="Find answers or get in touch.">
    <div class="space-y-6">
      <!-- Contact cards -->
      <section class="grid gap-4 sm:grid-cols-2">
        <a href="mailto:support@hiver.com.np" class="rounded-lg border border-border bg-card p-5 transition-colors hover:border-primary">
          <div class="grid size-9 place-items-center rounded-md bg-primary/10 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>
          </div>
          <h3 class="mt-3 text-sm font-semibold">Email support</h3>
          <p class="mt-1 text-sm text-muted-foreground">Reach the team at support@hiver.com.np</p>
        </a>
        <a href="#" class="rounded-lg border border-border bg-card p-5 transition-colors hover:border-primary">
          <div class="grid size-9 place-items-center rounded-md bg-primary/10 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
          </div>
          <h3 class="mt-3 text-sm font-semibold">Documentation</h3>
          <p class="mt-1 text-sm text-muted-foreground">Guides and tips for getting the most out of Viewport.</p>
        </a>
        <a href={telegramUrl} class="rounded-lg border border-border bg-card p-5 transition-colors hover:border-primary">
          <div class="grid size-9 place-items-center rounded-md bg-primary/10 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.94 4.16a1.3 1.3 0 0 0-1.38-.23L3.4 10.57c-.9.35-.88 1.62.03 1.94l4.3 1.5 1.67 5.25c.27.84 1.34 1.07 1.93.42l2.38-2.61 4.37 3.22c.76.56 1.84.13 2.02-.8l3.31-13.9a1.3 1.3 0 0 0-1.47-1.43ZM18.8 7.24l-8.6 7.52-.32 2.82-1.1-3.47 10.02-6.87Z"/></svg>
          </div>
          <h3 class="mt-3 text-sm font-semibold">Telegram</h3>
          <p class="mt-1 text-sm text-muted-foreground">Message support on Telegram.</p>
        </a>
        <a href={whatsappUrl} class="rounded-lg border border-border bg-card p-5 transition-colors hover:border-primary">
          <div class="grid size-9 place-items-center rounded-md bg-primary/10 text-primary">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.47 15.04L2.5 22l5.07-1.05A9.94 9.94 0 1 0 12.04 2Zm0 1.8a8.14 8.14 0 0 1 6.86 12.52 8.14 8.14 0 0 1-10.84 2.78l-.3-.16-2.88.6.61-2.8-.18-.31A8.13 8.13 0 0 1 12.04 3.8Zm-3.18 4.5c-.18 0-.47.07-.72.34-.25.28-.95.93-.95 2.27s.98 2.64 1.11 2.82c.14.18 1.9 3.03 4.69 4.13 2.32.91 2.8.73 3.3.68.51-.04 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.11-.25-.18-.53-.32-.28-.14-1.65-.81-1.9-.9-.26-.1-.44-.14-.63.14-.18.28-.72.9-.88 1.09-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.38-.83-.74-1.38-1.65-1.54-1.93-.16-.28-.02-.43.12-.57.12-.12.28-.32.42-.49.14-.16.18-.28.28-.46.09-.18.04-.35-.02-.49-.07-.14-.62-1.52-.86-2.07-.22-.54-.46-.47-.62-.48h-.49Z"/></svg>
          </div>
          <h3 class="mt-3 text-sm font-semibold">WhatsApp</h3>
          <p class="mt-1 text-sm text-muted-foreground">Chat with support on WhatsApp.</p>
        </a>
      </section>

      <!-- FAQ -->
      <section class="rounded-lg border border-border bg-card divide-y divide-border">
        {faqs.map((f) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-2 text-sm text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </section>
    </div>
  </AccountShell>
</Layout>
