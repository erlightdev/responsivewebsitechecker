---
import Layout from '../layouts/Layout.astro';
import AccountShell from '../components/AccountShell.astro';
import {
  getUserPlan,
  getActiveSubscription,
  listSubscriptionPayments,
  confirmSubscriptionFromReturn,
  type Txn,
} from '../lib/payments/subscription';
import { getPublicPricing } from '../lib/payments/plan-store';
import { isCreditEligible } from '../lib/payments/credits';
import { prisma } from '../lib/prisma';

// middleware guarantees a signed-in user on this gated page
const me = Astro.locals.user;
const userId = me?.id ?? '';

// Returning from hosted checkout? Verify the subscription against Dodo (not the
// query string) and mirror it locally so the plan reflects immediately.
const params = Astro.url.searchParams;
const justPaid = params.get('status') === 'success';
const returnedSubId = params.get('subscription_id');
if (justPaid && returnedSubId && me?.email) {
  await confirmSubscriptionFromReturn(returnedSubId, { id: userId, email: me.email });
}

const planState = await getUserPlan(userId);
const isPro = planState.plan === 'pro';

// Subscription + transaction details for the Pro panel.
const sub = isPro ? await getActiveSubscription(userId) : null;
const txns: Txn[] = sub ? await listSubscriptionPayments(sub.dodoSubscriptionId, 10) : [];
const fmtMoney = (cents: number, ccy: string) =>
  new Intl.NumberFormat(undefined, { style: 'currency', currency: ccy }).format(cents / 100);
const fmtDate = (d: Date) => d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
const txnBadge: Record<string, string> = {
  succeeded: 'text-primary bg-primary/15',
  processing: 'text-amber-600 bg-amber-500/15',
  failed: 'text-destructive bg-destructive/15',
  cancelled: 'text-muted-foreground bg-muted',
};

const pricing = await getPublicPricing();
const proMonthly = pricing.monthly?.amount ?? '—';
const proYearly = pricing.yearly?.amount ?? proMonthly;
const savings = pricing.yearlySavingsPct;

const plans = [
  {
    id: 'free', name: 'Free',
    monthly: { price: '$0', period: '/mo', note: '' },
    yearly: { price: '$0', period: '/yr', note: '' },
    features: ['Up to 6 screens', '2 saved workspaces', 'Light, dark & color themes'],
    current: !isPro,
  },
  {
    id: 'pro', name: 'Pro',
    monthly: { price: proMonthly, period: '/mo', note: '' },
    yearly: { price: proYearly, period: pricing.yearly ? '/yr' : '/mo', note: savings > 0 ? `Save ${savings}% vs monthly.` : '' },
    features: ['Unlimited screens & workspaces', 'Social previews & Capture', 'Priority support'],
    current: isPro, highlight: true,
  },
];

const statusLabel: Record<string, string> = {
  active: 'Active', on_hold: 'On hold', cancelled: 'Cancelled', expired: 'Expired', failed: 'Failed',
};

// Invite & earn: store credit that will auto-apply to an upgrade.
const usd = (cents: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency', currency: 'USD', maximumFractionDigits: cents % 100 === 0 ? 0 : 2,
  }).format(cents / 100);
const creditRow = await prisma.user.findUnique({ where: { id: userId }, select: { creditCents: true } });
const creditCents = creditRow?.creditCents ?? 0;
const creditAmount = usd(creditCents);
const creditEligible = await isCreditEligible(userId);

// On a successful return, surface how much credit was just applied (if any). Credit
// is first-upgrade only, so there's at most one applied redemption per account.
let appliedCreditAmount = '';
if (justPaid) {
  const applied = await prisma.creditRedemption.findFirst({
    where: { userId, status: 'applied' },
    orderBy: { updatedAt: 'desc' },
    select: { amountCents: true },
  });
  if (applied) appliedCreditAmount = usd(applied.amountCents);
}
---

<Layout title="Billing — Viewport">
  <AccountShell active="billing" heading="Billing" description="Manage your plan and payment details.">
    <div
      class="space-y-6"
      data-just-paid={justPaid ? '1' : undefined}
      data-is-pro={isPro ? '1' : undefined}
      data-credit-cents={creditCents}
      data-credit-amount={creditAmount}
      data-credit-applied={appliedCreditAmount || undefined}
    >
      <!-- Current plan banner -->
      <section class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-card p-5">
        <div>
          <p class="text-sm text-muted-foreground">Current plan</p>
          <p class="text-lg font-semibold">
            {isPro ? `Pro · ${planState.interval === 'yearly' ? 'Yearly' : 'Monthly'}` : 'Free'}
          </p>
          {isPro && planState.currentPeriodEnd && (
            <p class="mt-0.5 text-xs text-muted-foreground">
              {planState.cancelAtPeriodEnd ? 'Ends' : 'Renews'} {planState.currentPeriodEnd.toLocaleDateString()}
            </p>
          )}
        </div>
        <span class="rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-primary">
          {isPro ? (statusLabel[planState.status ?? ''] ?? 'Active') : 'Free'}
        </span>
      </section>

      <!-- Invite & earn credit -->
      {creditCents > 0 && (
        <section class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-primary/30 bg-primary/5 p-5">
          <div class="flex items-center gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary/15 text-primary">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12 M2 7h20v5H2z M12 22V7 M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            </span>
            <div>
              <p class="text-sm font-semibold">{creditAmount} in referral credit</p>
              <p class="text-xs text-muted-foreground">
                {creditEligible
                  ? 'Applied automatically on your first upgrade — no tax on credit.'
                  : 'Credit applies only to a new account’s first upgrade.'}
              </p>
            </div>
          </div>
          <a href="/invite" class="text-sm font-medium text-primary hover:underline">Earn more</a>
        </section>
      )}

      <!-- Billing period toggle -->
      {pricing.yearly && (
        <div class="flex justify-center">
          <div class="inline-flex items-center gap-1 rounded-full border border-border bg-card p-1" id="billing-toggle" role="tablist" aria-label="Billing period">
            <button type="button" data-period="monthly" class="billing-opt rounded-full px-4 py-1.5 text-sm font-semibold transition-colors bg-primary text-primary-foreground" aria-selected="true">Monthly</button>
            <button type="button" data-period="yearly" class="billing-opt inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground" aria-selected="false">
              Yearly
              {savings > 0 && <span class="rounded-full bg-primary/10 px-1.5 py-0.5 text-[11px] font-semibold text-primary">-{savings}%</span>}
            </button>
          </div>
        </div>
      )}

      <!-- Plans -->
      <section class="grid gap-4 md:grid-cols-2">
        {plans.map((p) => (
          <div class:list={['flex flex-col rounded-lg border bg-card p-5', p.highlight ? 'border-primary ring-1 ring-primary/30' : 'border-border']}>
            <div class="flex items-center justify-between">
              <h3 class="font-semibold">{p.name}</h3>
              {p.highlight && <span class="rounded-full bg-primary/15 px-2 py-0.5 text-[11px] font-semibold text-primary">Popular</span>}
            </div>
            <p class="mt-2">
              <span class="price-amount text-2xl font-bold" data-monthly={p.monthly.price} data-yearly={p.yearly.price}>{p.monthly.price}</span>
              <span class="price-period text-sm text-muted-foreground" data-monthly={p.monthly.period} data-yearly={p.yearly.period}>{p.monthly.period}</span>
            </p>
            <p class="price-note mt-1 text-xs text-muted-foreground" data-monthly={p.monthly.note} data-yearly={p.yearly.note} style={p.monthly.note ? '' : 'display:none'}>{p.monthly.note}</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-muted-foreground">
              {p.features.map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 size-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <button
              type="button"
              disabled={p.current}
              data-checkout={p.id === 'pro' && !p.current ? 'pro' : undefined}
              class:list={['mt-5 h-9 rounded-md px-4 text-sm font-semibold transition-transform', p.current ? 'cursor-default border border-border bg-muted text-muted-foreground' : 'bg-primary text-primary-foreground hover:scale-[1.02] disabled:opacity-60']}
            >
              {p.current ? 'Current plan' : `Upgrade to ${p.name}`}
            </button>
          </div>
        ))}
      </section>

      <!-- Subscription details (Pro only) -->
      {sub && (
        <section class="rounded-lg border border-border bg-card p-6">
          <h2 class="text-sm font-semibold">Subscription details</h2>
          <dl class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            <div class="flex items-center justify-between gap-3 sm:block">
              <dt class="text-xs text-muted-foreground">Plan</dt>
              <dd class="text-sm font-medium">Pro · {sub.interval === 'yearly' ? 'Yearly' : 'Monthly'}</dd>
            </div>
            <div class="flex items-center justify-between gap-3 sm:block">
              <dt class="text-xs text-muted-foreground">Status</dt>
              <dd class="text-sm font-medium capitalize">{(statusLabel[sub.status] ?? sub.status)}</dd>
            </div>
            <div class="flex items-center justify-between gap-3 sm:block">
              <dt class="text-xs text-muted-foreground">{sub.cancelAtPeriodEnd ? 'Ends on' : 'Renews on'}</dt>
              <dd class="text-sm font-medium">{sub.currentPeriodEnd ? fmtDate(sub.currentPeriodEnd) : '—'}</dd>
            </div>
            <div class="flex items-center justify-between gap-3 sm:block">
              <dt class="text-xs text-muted-foreground">Subscription ID</dt>
              <dd class="font-mono text-xs text-muted-foreground">{sub.dodoSubscriptionId}</dd>
            </div>
          </dl>
        </section>
      )}

      <!-- Transaction history (Pro only) -->
      {sub && (
        <section class="rounded-lg border border-border bg-card p-6">
          <h2 class="text-sm font-semibold">Transaction history</h2>
          {txns.length === 0 ? (
            <p class="mt-2 text-sm text-muted-foreground">No transactions yet. Your first charge will appear here shortly.</p>
          ) : (
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-border/60 text-left text-xs text-muted-foreground">
                    <th class="pb-2 pr-4 font-medium">Date</th>
                    <th class="pb-2 pr-4 font-medium">Amount</th>
                    <th class="pb-2 pr-4 font-medium">Method</th>
                    <th class="pb-2 pr-4 font-medium">Status</th>
                    <th class="pb-2 font-medium">Invoice</th>
                  </tr>
                </thead>
                <tbody>
                  {txns.map((t) => (
                    <tr class="border-b border-border/40 last:border-0">
                      <td class="py-2.5 pr-4 whitespace-nowrap">{fmtDate(t.date)}</td>
                      <td class="py-2.5 pr-4 font-medium">{fmtMoney(t.amount, t.currency)}</td>
                      <td class="py-2.5 pr-4 text-muted-foreground">
                        {t.cardNetwork ? `${t.cardNetwork} ···· ${t.cardLast4 ?? ''}` : '—'}
                      </td>
                      <td class="py-2.5 pr-4">
                        <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-semibold capitalize', txnBadge[t.status] ?? 'text-muted-foreground bg-muted']}>{t.status}</span>
                      </td>
                      <td class="py-2.5">
                        {t.invoiceUrl
                          ? <a href={t.invoiceUrl} target="_blank" rel="noopener" class="text-primary hover:underline">View</a>
                          : <span class="text-muted-foreground">—</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      )}

      <!-- Payment method -->
      <section class="rounded-lg border border-border bg-card p-6">
        <h2 class="text-sm font-semibold">Payment method</h2>
        <p class="mt-1 text-sm text-muted-foreground">{sub ? 'Managed securely by Dodo Payments at checkout.' : 'No payment method on file.'}</p>
        {!sub && <button type="button" class="mt-4 h-9 rounded-md border border-border bg-background px-4 text-sm font-medium transition-colors hover:bg-muted">Add payment method</button>}
      </section>
    </div>

    <!-- shadcn-style dialog (replaces native alert) -->
    <div id="bill-dialog" class="fixed inset-0 z-[80] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="bill-dialog-title">
      <div id="bill-dialog-overlay" class="absolute inset-0 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity duration-200"></div>
      <div id="bill-dialog-panel" class="relative z-10 grid w-full max-w-sm scale-95 gap-4 rounded-lg border border-border bg-background p-6 opacity-0 shadow-lg transition-all duration-200 ease-out">
        <div class="flex flex-col gap-1.5">
          <h2 id="bill-dialog-title" class="text-base font-semibold leading-none tracking-tight">Notice</h2>
          <p id="bill-dialog-desc" class="text-sm text-muted-foreground"></p>
        </div>
        <div class="flex justify-end">
          <button type="button" id="bill-dialog-ok" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">OK</button>
        </div>
      </div>
    </div>
  </AccountShell>
</Layout>

<script>
  import { toast } from '../lib/toast';

  // ----- shadcn-style dialog helper (replaces native alert) -----
  const dlg = document.getElementById('bill-dialog');
  const dlgPanel = document.getElementById('bill-dialog-panel');
  const dlgOverlay = document.getElementById('bill-dialog-overlay');
  const dlgTitle = document.getElementById('bill-dialog-title');
  const dlgDesc = document.getElementById('bill-dialog-desc');
  const dlgOk = document.getElementById('bill-dialog-ok');

  function showDialog(title: string, desc: string) {
    if (!dlg || !dlgTitle || !dlgDesc) return;
    dlgTitle.textContent = title;
    dlgDesc.textContent = desc;
    dlg.classList.remove('hidden');
    dlg.classList.add('flex');
    requestAnimationFrame(() => {
      dlgOverlay?.classList.add('opacity-100');
      dlgPanel?.classList.remove('scale-95', 'opacity-0');
    });
  }
  function closeDialog() {
    if (!dlg) return;
    dlgOverlay?.classList.remove('opacity-100');
    dlgPanel?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => { dlg.classList.add('hidden'); dlg.classList.remove('flex'); }, 180);
  }
  dlgOk?.addEventListener('click', closeDialog);
  dlgOverlay?.addEventListener('click', closeDialog);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDialog(); });

  let currentPeriod: 'monthly' | 'yearly' = 'monthly';

  const billingToggle = document.getElementById('billing-toggle');
  if (billingToggle) {
    const opts = billingToggle.querySelectorAll<HTMLButtonElement>('.billing-opt');
    const setPeriod = (period: 'monthly' | 'yearly') => {
      currentPeriod = period;
      opts.forEach((o) => {
        const active = o.dataset.period === period;
        o.setAttribute('aria-selected', String(active));
        o.classList.toggle('bg-primary', active);
        o.classList.toggle('text-primary-foreground', active);
        o.classList.toggle('text-muted-foreground', !active);
      });
      document.querySelectorAll<HTMLElement>('.price-amount, .price-period').forEach((el) => {
        el.textContent = el.dataset[period] ?? el.textContent;
      });
      document.querySelectorAll<HTMLElement>('.price-note').forEach((el) => {
        const note = el.dataset[period] ?? '';
        el.textContent = note;
        el.style.display = note ? '' : 'none';
      });
    };
    opts.forEach((o) => o.addEventListener('click', () => setPeriod(o.dataset.period as 'monthly' | 'yearly')));
  }

  // Upgrade → create a Dodo checkout session and redirect to hosted checkout.
  const proBtn = document.querySelector<HTMLButtonElement>('[data-checkout="pro"]');
  proBtn?.addEventListener('click', async () => {
    proBtn.disabled = true;
    const original = proBtn.textContent;
    proBtn.textContent = 'Redirecting…';
    try {
      const res = await fetch('/api/payments/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ interval: currentPeriod }),
      });
      const data = (await res.json()) as { url?: string; error?: string };
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      showDialog(
        'Checkout unavailable',
        data.error === 'product_not_configured' || data.error === 'payments_not_configured'
          ? 'Payments are not configured yet. Please try again later.'
          : 'Could not start checkout. Please try again.',
      );
    } catch {
      showDialog('Network error', 'Please check your connection and try again.');
    }
    proBtn.disabled = false;
    proBtn.textContent = original;
  });

  const params = new URLSearchParams(location.search);

  const creditRoot = document.querySelector<HTMLElement>('[data-credit-cents]');

  // Returned from a successful checkout (already confirmed server-side).
  if (document.querySelector('[data-just-paid]')) {
    const isProNow = !!document.querySelector('[data-is-pro]');
    showDialog(
      isProNow ? 'Payment confirmed' : 'Payment received',
      isProNow
        ? 'Your Pro plan is now active. Enjoy unlimited screens, Social previews and Capture.'
        : 'Thanks! Your payment is being finalized — your plan will update shortly.',
    );
    if (isProNow) {
      toast.success('Pro plan activated', { description: 'Unlimited screens, Social previews and Capture are unlocked.', log: 'Upgraded to Pro' });
    }
    const applied = creditRoot?.dataset.creditApplied;
    if (applied) {
      toast.success('Referral credit applied', { description: `${applied} was deducted from this purchase.`, log: 'Referral credit applied' });
    }
    history.replaceState(null, '', '/billing'); // strip checkout params from the URL
  }

  // Keep the cross-page credit baseline in sync so the invite page doesn't
  // re-announce an increase the user has already seen here.
  if (creditRoot) {
    localStorage.setItem('vp-credit-seen', String(Number(creditRoot.dataset.creditCents || '0')));
  }

  // Arrived from a "Get Pro" CTA (e.g. right after signup) → preselect the
  // interval and start checkout automatically. proBtn is absent if already Pro.
  if (params.get('upgrade') === 'pro' && proBtn) {
    if (params.get('interval') === 'yearly') {
      document.querySelector<HTMLButtonElement>('.billing-opt[data-period="yearly"]')?.click();
    }
    proBtn.click();
  }
</script>
