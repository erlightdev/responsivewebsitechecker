---
import Layout from '../layouts/Layout.astro';

const hasGithub = !!(import.meta.env.GITHUB_CLIENT_ID && import.meta.env.GITHUB_CLIENT_SECRET);
const hasGoogle = !!(import.meta.env.GOOGLE_CLIENT_ID && import.meta.env.GOOGLE_CLIENT_SECRET);
const anySocial = hasGithub || hasGoogle;
---

<Layout title="Sign in — Viewport">
  <main class="grid min-h-dvh place-items-center px-4 py-10">
    <div class="w-full max-w-sm">
      <!-- Logo -->
      <div class="mb-6 flex justify-center">
        <span class="grid size-12 place-items-center rounded-full bg-primary text-primary-foreground">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        </span>
      </div>

      <!-- Title (shared by email + password steps) -->
      <div id="title-signin" class="mb-7 text-center">
        <h1 class="text-2xl font-bold tracking-tight">Sign in to Viewport</h1>
        <p class="mt-2 text-sm text-muted-foreground">Don't have an account? <a href="/signup" class="font-semibold text-foreground hover:underline">Sign up</a></p>
      </div>

      <!-- Step 1: email + method choice -->
      <section id="step-email">
        {anySocial && (
          <>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {hasGoogle && (
                <button type="button" data-social="google" class="flex h-11 items-center justify-center gap-2.5 rounded-lg border border-border bg-card text-sm font-medium transition-colors hover:bg-muted">
                  <svg class="size-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38z"/></svg>
                  Sign in with Google
                </button>
              )}
              {hasGithub && (
                <button type="button" data-social="github" class="flex h-11 items-center justify-center gap-2.5 rounded-lg border border-border bg-card text-sm font-medium transition-colors hover:bg-muted">
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.26C22 6.58 17.52 2 12 2z"/></svg>
                  Sign in with GitHub
                </button>
              )}
            </div>
            <div class="my-5 flex items-center gap-3 text-xs text-muted-foreground"><span class="h-px flex-1 bg-border"></span>Or<span class="h-px flex-1 bg-border"></span></div>
          </>
        )}

        <form id="email-form" class="space-y-4">
          <div class="space-y-1.5">
            <label for="email" class="text-sm text-muted-foreground">Enter your email</label>
            <input id="email" type="email" autocomplete="email" required placeholder="name@email.com" class="h-11 w-full rounded-lg border border-border bg-background px-3.5 text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-ring/40" />
          </div>
          <button type="submit" class="h-12 w-full rounded-lg border border-border bg-card text-sm font-medium transition-colors hover:bg-muted disabled:opacity-60">Continue with password</button>
          <button type="button" id="email-otp-btn" class="flex h-12 w-full items-center justify-center gap-2 rounded-lg border border-border bg-card text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground disabled:opacity-60">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            Log in with OTP
          </button>
        </form>
      </section>

      <!-- Step 2: password -->
      <section id="step-password" class="hidden">
        <form id="password-form" class="space-y-4">
          <div class="space-y-1.5">
            <label for="pw-email" class="text-sm text-muted-foreground">Enter your email</label>
            <input id="pw-email" type="email" autocomplete="email" class="h-11 w-full rounded-lg border border-border bg-background px-3.5 text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-ring/40" />
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="password" class="text-sm text-muted-foreground">Password</label>
              <a href="/forgot-password" class="text-sm font-semibold text-foreground hover:underline">Forgot Password</a>
            </div>
            <div class="relative">
              <input id="password" type="password" autocomplete="current-password" placeholder="Enter your password" class="h-11 w-full rounded-lg border border-border bg-background px-3.5 pr-10 text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-ring/40" />
              <button type="button" id="pw-toggle" aria-label="Show password" class="absolute right-2 top-1/2 grid size-7 -translate-y-1/2 place-items-center rounded text-muted-foreground hover:text-foreground">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <p id="pw-error" class="hidden text-sm font-medium text-destructive"></p>
          </div>
          <button type="submit" class="h-12 w-full rounded-lg bg-foreground text-sm font-semibold text-background transition-opacity hover:opacity-90 disabled:opacity-60">Continue</button>
          <button type="button" id="pw-otp-btn" class="flex h-12 w-full items-center justify-center gap-2 rounded-lg border border-border bg-card text-sm font-medium transition-colors hover:bg-muted disabled:opacity-60">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            Log in with OTP
          </button>
        </form>
      </section>

      <!-- Step 3: OTP -->
      <section id="step-otp" class="hidden">
        <div class="mb-7 text-center">
          <h1 class="text-2xl font-bold tracking-tight">Enter verification code</h1>
          <p class="mt-2 text-sm text-muted-foreground">Enter the 6-digit code sent to <span id="otp-email" class="text-foreground"></span></p>
        </div>
        <form id="otp-form" class="space-y-5">
          <div id="otp-boxes" class="flex justify-center gap-2">
            {Array.from({ length: 6 }).map(() => (
              <input data-otp type="text" inputmode="numeric" maxlength="1" class="size-12 rounded-lg border border-border bg-background text-center text-lg font-semibold outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-ring/40" />
            ))}
          </div>
          <button type="submit" class="mx-auto block h-11 rounded-lg border border-border bg-card px-6 text-sm font-semibold transition-colors hover:bg-muted disabled:opacity-60">Verify &amp; log in</button>
        </form>
        <div class="mt-2 text-center">
          <button type="button" id="otp-resend" class="text-sm font-medium text-muted-foreground hover:text-foreground disabled:opacity-60"></button>
        </div>
        <div class="mt-1 text-center">
          <button type="button" id="otp-back" class="text-sm font-semibold text-foreground hover:underline">Use a different method</button>
        </div>
      </section>

      <!-- Footer (hidden on OTP step) -->
      <div id="footer">
        <p class="mt-6 text-center text-xs leading-relaxed text-muted-foreground">
          By signing in, you agree to our <a href="#" class="underline hover:text-foreground">Terms &amp; Conditions</a> and <a href="#" class="underline hover:text-foreground">Privacy Policy</a>
        </p>
        <p class="mt-5 text-center text-sm text-muted-foreground">Need help? <a href="/help" class="font-semibold text-foreground hover:underline">Contact support</a></p>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { signIn, emailOtp } from '../lib/auth-client';
  import { setupOtpInputs, startCountdown } from '../lib/otp-ui';
  import { toast } from '../lib/toast';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const params = new URLSearchParams(location.search);
  const next = params.get('next') || '/checker';
  // append an ?auth= flag so the dashboard can show a welcome toast post-redirect
  const withAuth = (url: string, flag: string) => {
    const u = new URL(url, location.origin);
    u.searchParams.set('auth', flag);
    return u.pathname + u.search;
  };

  const showError = (msg: string) => toast.error(msg);
  const clearError = () => {};
  if (params.get('error') === 'banned') toast.error('Account suspended', { description: 'Contact an administrator.', log: false });
  if (params.get('error') === 'restricted') toast.warning('Access restricted', { description: 'You do not have access to that area.', log: false });
  if (params.get('error') === 'signup_disabled') toast.error('No account found', { description: 'No account is linked to that Google/GitHub login. Please sign up first.', log: false });

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const sections = { email: $('step-email'), password: $('step-password'), otp: $('step-otp') } as const;
  const titleSignin = $('title-signin');
  const footer = $('footer');

  let email = '';

  // Ask the server whether this email has an account (and how it signs in).
  // Returns only data for the queried email — never other users.
  async function lookup(addr: string): Promise<{ exists: boolean; verified: boolean; methods: string[] }> {
    try {
      const res = await fetch('/api/auth-method', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: addr }),
      });
      if (!res.ok) return { exists: false, verified: false, methods: [] };
      return await res.json();
    } catch {
      return { exists: false, verified: false, methods: [] };
    }
  }

  const noAccountMsg = 'No account found for that email. Create one on the sign-up page.';

  function show(step: keyof typeof sections) {
    clearError();
    Object.values(sections).forEach((el) => (el.style.display = 'none'));
    sections[step].style.display = 'block';
    // Shared "Sign in to Viewport" title shows on email + password; OTP step has its own.
    titleSignin.style.display = step === 'otp' ? 'none' : 'block';
    footer.style.display = step === 'otp' ? 'none' : 'block';
  }

  // --- Step 1: email ---
  $('email-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();
    email = ($('email') as HTMLInputElement).value.trim().toLowerCase();
    if (!emailRe.test(email)) return showError('Enter a valid email address.');

    const btn = $('email-form').querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    const acct = await lookup(email);
    btn.disabled = false;
    if (!acct.exists) return showError(noAccountMsg);
    if (!acct.methods.includes('credential')) {
      // account exists but has no password (passwordless or social only)
      if (acct.methods.length) return showError(`This account signs in with ${acct.methods.join(' or ')}.`);
      return showError("This account signs in with a code. Tap “Log in with OTP”.");
    }
    ($('pw-email') as HTMLInputElement).value = email;
    show('password');
    ($('password') as HTMLInputElement).focus();
  });

  $('email-otp-btn').addEventListener('click', async () => {
    email = ($('email') as HTMLInputElement).value.trim().toLowerCase();
    if (!emailRe.test(email)) return showError('Enter your email first.');
    const btn = $('email-otp-btn') as HTMLButtonElement;
    btn.disabled = true;
    const acct = await lookup(email);
    if (!acct.exists) { btn.disabled = false; return showError(noAccountMsg); }
    await sendOtp(btn);
  });

  // --- password show/hide ---
  $('pw-toggle').addEventListener('click', () => {
    const inp = $('password') as HTMLInputElement;
    inp.type = inp.type === 'password' ? 'text' : 'password';
  });

  // --- Step 2: password sign-in ---
  $('password-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();
    email = ($('pw-email') as HTMLInputElement).value.trim().toLowerCase();
    const password = ($('password') as HTMLInputElement).value;
    const err = $('pw-error');
    err.style.display = 'none';
    if (password.length < 8) { err.textContent = 'Password must be at least 8 characters.'; err.style.display = 'block'; return; }

    const btn = $('password-form').querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await signIn.email({ email, password });
    btn.disabled = false;
    if (!error) {
      location.href = withAuth(next, 'login');
      return;
    }
    err.textContent = error.message || 'Incorrect email or password. Try OTP if you signed up passwordless.';
    err.style.display = 'block';
  });

  $('pw-otp-btn').addEventListener('click', async () => {
    email = ($('pw-email') as HTMLInputElement).value.trim().toLowerCase();
    if (!emailRe.test(email)) return showError('Enter a valid email.');
    const btn = $('pw-otp-btn') as HTMLButtonElement;
    btn.disabled = true;
    const acct = await lookup(email);
    if (!acct.exists) { btn.disabled = false; return showError(noAccountMsg); }
    await sendOtp(btn);
  });

  // --- OTP ---
  const otp = setupOtpInputs($('otp-boxes'));
  let stopTimer: (() => void) | null = null;

  async function sendOtp(btn: HTMLButtonElement) {
    btn.disabled = true;
    const { error } = await emailOtp.sendVerificationOtp({ email, type: 'sign-in' });
    btn.disabled = false;
    if (error) return showError(error.message || 'Could not send the code.');
    toast.success('Verification code sent!', { description: email, log: 'Sign-in code sent' });
    $('otp-email').textContent = email;
    otp.clear();
    show('otp');
    otp.focus();
    stopTimer?.();
    stopTimer = startCountdown($('otp-resend') as HTMLButtonElement, 60, 'Resend code');
  }

  $('otp-resend').addEventListener('click', async () => {
    await emailOtp.sendVerificationOtp({ email, type: 'sign-in' });
    toast.info('New code sent', { log: false });
    stopTimer?.();
    stopTimer = startCountdown($('otp-resend') as HTMLButtonElement, 60, 'Resend code');
  });

  $('otp-back').addEventListener('click', () => show('email'));

  $('otp-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();
    const code = otp.value();
    if (code.length !== 6) return showError('Enter all 6 digits.');
    const btn = $('otp-form').querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await signIn.emailOtp({ email, otp: code });
    btn.disabled = false;
    if (error) return showError(error.message || 'Invalid or expired code.');
    location.href = withAuth(next, 'login');
  });

  // --- Social ---
  // No requestSignUp here: if the Google/GitHub account isn't registered, Better
  // Auth redirects to errorCallbackURL with ?error=signup_disabled instead of
  // silently creating an account.
  document.querySelectorAll<HTMLButtonElement>('[data-social]').forEach((b) =>
    b.addEventListener('click', () =>
      signIn.social({
        provider: b.dataset.social as 'github' | 'google',
        callbackURL: withAuth(next, 'login'),
        errorCallbackURL: '/login?error=signup_disabled',
      })
    )
  );
</script>
