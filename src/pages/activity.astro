---
import Layout from '../layouts/Layout.astro';
import AccountShell from '../components/AccountShell.astro';
---

<Layout title="Activity log — Viewport">
  <AccountShell active="activity" heading="Activity log" description="Recent actions — screens, workspaces, captures, and more.">
    <div class="space-y-4">
      <!-- Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div id="activity-filters" class="flex flex-wrap items-center gap-1.5 text-sm">
          <button type="button" data-filter="all" class="filter-chip h-8 rounded-md border border-border bg-card px-3 text-xs font-medium transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary" aria-pressed="true">All</button>
          <button type="button" data-filter="success" class="filter-chip h-8 rounded-md border border-border bg-card px-3 text-xs font-medium transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary" aria-pressed="false">Success</button>
          <button type="button" data-filter="info" class="filter-chip h-8 rounded-md border border-border bg-card px-3 text-xs font-medium transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary" aria-pressed="false">Info</button>
          <button type="button" data-filter="warning" class="filter-chip h-8 rounded-md border border-border bg-card px-3 text-xs font-medium transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary" aria-pressed="false">Warnings</button>
          <button type="button" data-filter="error" class="filter-chip h-8 rounded-md border border-border bg-card px-3 text-xs font-medium transition-colors hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary" aria-pressed="false">Errors</button>
        </div>
        <button type="button" id="activity-clear" class="h-8 shrink-0 rounded-md border border-border bg-card px-3 text-xs font-medium transition-colors hover:border-destructive/40 hover:bg-destructive/10 hover:text-destructive disabled:pointer-events-none disabled:opacity-50">Clear log</button>
      </div>

      <!-- Log -->
      <section class="rounded-lg border border-border bg-card">
        <ul id="activity-list" class="divide-y divide-border/60"></ul>
        <div id="activity-empty" class="hidden p-10 text-center text-sm text-muted-foreground">No activity recorded yet.</div>
      </section>
    </div>
  </AccountShell>
</Layout>

<script>
  import { getActivity, clearActivity, type ActivityEntry } from '../lib/activity-log';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = $('activity-list');
  const empty = $('activity-empty');
  const clearBtn = $('activity-clear') as HTMLButtonElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];

  let filter: 'all' | ActivityEntry['type'] = 'all';

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const ICON: Record<ActivityEntry['type'], { c: string; svg: string }> = {
    success: { c: 'text-emerald-600 dark:text-emerald-400', svg: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>' },
    error: { c: 'text-destructive', svg: '<circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/>' },
    warning: { c: 'text-amber-600 dark:text-amber-400', svg: '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/>' },
    info: { c: 'text-blue-600 dark:text-blue-400', svg: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>' },
  };

  const relTime = (t: number) => {
    const s = Math.round((Date.now() - t) / 1000);
    if (s < 60) return 'just now';
    const m = Math.round(s / 60);
    if (m < 60) return `${m}m ago`;
    const h = Math.round(m / 60);
    if (h < 24) return `${h}h ago`;
    const d = Math.round(h / 24);
    if (d < 7) return `${d}d ago`;
    return new Date(t).toLocaleDateString();
  };

  function render() {
    const all = getActivity();
    const items = filter === 'all' ? all : all.filter((e) => e.type === filter);
    clearBtn.disabled = all.length === 0;
    empty.style.display = items.length ? 'none' : 'block';
    empty.textContent = all.length === 0 ? 'No activity recorded yet.' : 'No matching activity.';
    list.innerHTML = items
      .map((e) => {
        const ic = ICON[e.type];
        return `<li class="flex items-start gap-3 px-5 py-3.5">
          <span class="mt-0.5 ${ic.c}"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ic.svg}</svg></span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium">${esc(e.action)}</p>
            ${e.detail ? `<p class="truncate text-xs text-muted-foreground">${esc(e.detail)}</p>` : ''}
          </div>
          <time class="shrink-0 text-xs text-muted-foreground" title="${esc(new Date(e.at).toLocaleString())}">${relTime(e.at)}</time>
        </li>`;
      })
      .join('');
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter as typeof filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      render();
    })
  );

  clearBtn.addEventListener('click', () => { clearActivity(); render(); });
  render();
</script>
