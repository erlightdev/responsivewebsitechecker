// Prisma 7 schema for Better Auth (email/password + emailOTP + admin plugins)
// over MySQL. Regenerate the client with `npx prisma generate`; push schema
// changes with `npx prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // admin plugin
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Dodo Payments customer id (set after first checkout; reused for later purchases)
  dodoCustomerId String? @unique

  sessions      Session[]
  accounts      Account[]
  flags         ResourceFlag[]
  subscriptions Subscription[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // admin plugin (impersonation)
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Superadmin-authored subscription plan. Created in the app and synced to Dodo
// Payments (a Dodo product is created via API and its id stored here). Checkout
// reads the product id from this table — no product ids in env.
model Plan {
  id            String   @id @default(cuid())
  // One Pro plan per billing interval keeps it aligned with the 2-plan model.
  interval      String   @unique // 'monthly' | 'yearly'
  name          String
  description   String?  @db.Text
  priceCents    Int // amount in the smallest currency unit (e.g. cents)
  currency      String   @default("USD")
  taxCategory   String   @default("saas") // Dodo tax_category: saas|digital_products|e_book|edtech
  dodoProductId String?  @unique // set after a successful sync to Dodo
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("plan")
}

// Dodo Payments subscription mirror. Source of truth is Dodo; this table is
// kept in sync via verified webhooks and read for plan/feature gating.
model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  dodoSubscriptionId String    @unique
  dodoCustomerId     String?
  productId          String?
  plan               String    @default("pro") // 'pro'
  interval           String    @default("monthly") // 'monthly' | 'yearly'
  // active | on_hold | cancelled | expired | failed | pending
  status             String    @default("pending")
  cancelAtPeriodEnd  Boolean   @default(false)
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscription")
}

// Idempotency ledger for incoming webhooks (keyed by Dodo's webhook-id header).
// A row existing means the event was already processed — skip re-processing.
model WebhookEvent {
  id        String   @id // value of the `webhook-id` header
  type      String
  createdAt DateTime @default(now())

  @@map("webhook_event")
}

// Custom: per-user, per-resource access flags toggled by a superadmin.
// A missing row means "allowed" (default). allowed=false blocks the resource.
model ResourceFlag {
  id        String   @id @default(cuid())
  userId    String
  resource  String // checker | captures | workspaces | social
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
  @@map("resource_flag")
}
